#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

# ▄▄▄▄   ▄▄  ▄▄▄  ▄  ▄ 
# █ █ █ █▀▀▀ █  █ █  █ 
# ▀ ▀ ▀  ▀▀▀ ▀  ▀  ▀▀▀ 
# menu - the bar button: wifi, volume, bluetooth, vpn, brightness.
# A pick opens its menu in this window, Esc there comes back here.
# A part turned off in shh config has no script in ~/.local/bin, so no line.
# menu open: the window, as tall as the menu (the bar runs this)
# menu --header NAME: the banner of a menu (header below)

set -eu

bin="$HOME/.local/bin"
tab=$(printf '\t')

# "script<TAB>icon  Name >", only the installed ones
lines() {
    local s
    for s in 'wifi	  Wifi >' \
        'volume	󰕾  Volume >' \
        'bluetooth	  Bluetooth >' \
        'vpn	󰖂  VPN >' \
        'brightness	󰃠  Light >'; do
        [ ! -x "$bin/${s%%"$tab"*}" ] || printf '%s\n' "$s"
    done
}

# art NAME: the banner of a menu. menu: font Bloody (patorjk.com), like the
# fastfetch logo, N made narrower; the others: Linguaholic Mini Block
art() {
    case "$1" in
        menu) cat <<'EOF'
 ███▄ ▄███▓▓█████  ███▄  █  █    ██
▓██▒▀█▀ ██▒▓█   ▀  ██ ▀█ █  ██  ▓██▒
▓██    ▓██░▒███   ▓██  ▀██▒▓██  ▒██░
▒██    ▒██ ▒▓█  ▄ ▓██▒ ▐██▒▓▓█  ░██░
▒██▒   ░██▒░▒████▒▒██░  ██░▒▒█████▓
░ ▒░   ░  ░░░ ▒░ ░░ ▒░  ▒ ▒░▒▓▒ ▒ ▒
░  ░      ░ ░ ░  ░░ ░░  ░ ▒░░▒░ ░ ░
░      ░      ░      ░  ░ ░ ░░░ ░ ░
       ░      ░  ░        ░   ░
EOF
            ;;
        wifi) cat <<'EOF'
▄   ▄ ▀  ▄▀▀ ▀
█ █ █ █ ▀█▀  █
 ▀ ▀  ▀  ▀   ▀
EOF
            ;;
        volume) cat <<'EOF'
▄   ▄  ▄▄  █ ▄  ▄ ▄▄▄▄   ▄▄
▀▄ ▄▀ █  █ █ █  █ █ █ █ █▀▀▀
  ▀    ▀▀  ▀  ▀▀▀ ▀ ▀ ▀  ▀▀▀
EOF
            ;;
        bluetooth) cat <<'EOF'
█▄▄  █ ▄  ▄  ▄▄  ▄█▄   ▄▄   ▄▄  ▄█▄  █▄▄
█  █ █ █  █ █▀▀▀  █   █  █ █  █  █   █  █
▀▀▀  ▀  ▀▀▀  ▀▀▀   ▀▀  ▀▀   ▀▀    ▀▀ ▀  ▀
EOF
            ;;
        vpn) cat <<'EOF'
▄   ▄ ▄▄▄  ▄▄▄
▀▄ ▄▀ █  █ █  █
  ▀   █▀▀  ▀  ▀
      ▀
EOF
            ;;
        light) cat <<'EOF'
█ ▀  ▄▄▄ █▄▄  ▄█▄
█ █ █  █ █  █  █
▀ ▀  ▀▀█ ▀  ▀   ▀▀
     ▀▀
EOF
            ;;
    esac
}

# chars TEXT: its width; wc -m counts characters, ${#var} in dash bytes
chars() {
    printf '%s' "$1" | wc -m
}

# pad WIDTH: stdin moved to the middle of fzf (FZF_COLUMNS);
# 4 = the border and the cursor column, like center() in shh
pad() {
    local p=$(( (${FZF_COLUMNS:-0} - 4 - $1) / 2 ))
    [ "$p" -gt 0 ] || p=0
    sed "s/^/$(printf '%*s' "$p" '')/"
}

# header NAME: an empty line, the art of NAME, an empty line, $MENU_TEXT,
# all in the middle. fzf runs it on start and on every resize (sway sets
# the width after the window opens): the menus bind
# start,resize:transform-header:sh ~/.local/bin/menu --header NAME
header() {
    local a l w=0
    a=$(art "$1")
    while IFS= read -r l; do
        [ "$(chars "$l")" -le "$w" ] || w=$(chars "$l")
    done <<EOF
$a
EOF
    echo ' '
    printf '%s\n' "$a" | pad "$w"
    echo ' '
    [ -n "${MENU_TEXT:-}" ] || return 0
    printf '%s\n' "$MENU_TEXT" | while IFS= read -r l; do
        printf '%s\n' "$l" | pad "$(chars "$l")"
    done
}

case "${1:-}" in
    --header) header "${2:-menu}"; exit 0 ;;
    # rows: the border, the header (11), the lines and one empty line;
    # sway/rules sets only the width
    open) exec footclient --app-id=menu --window-size-chars="50x$(($(lines | wc -l) + 13))" "$0" ;;
esac

# no text under the art here (a menu opened from here sets its own)
export MENU_TEXT=

# pos keeps the cursor on the last picked line
pos=1
while :; do
    list=$(lines)
    pick=$(printf '%s\n' "$list" |
        fzf --info=hidden --no-input --delimiter="$tab" --with-nth=2 --border-label=' Menu ' \
            --bind="start,resize:transform-header:sh '$0' --header menu" --bind="load:pos($pos)") || exit 0
    pos=$(printf '%s\n' "$list" | grep -nxF -- "$pick" | cut -d: -f1)
    # a menu that fails (no wifi device...) just comes back here
    "$bin/${pick%%"$tab"*}" || true
done
