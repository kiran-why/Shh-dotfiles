#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

# ▄▄▄▄   ▄▄  ▄▄▄  ▄  ▄ 
# █ █ █ █▀▀▀ █  █ █  █ 
# ▀ ▀ ▀  ▀▀▀ ▀  ▀  ▀▀▀ 
# The menu of the bar button: wifi, volume, bluetooth, vpn, settings, power.
#
# A pick opens its menu in this window, Esc there comes back here. A part
# turned off in 'shh config' has no script in ~/.local/bin, so no line.
#
# 'menu open' opens the window, or closes it when it is open (the bar and
# $mod+m run this). 'menu --header NAME' prints the banner of a menu and
# makes the window fit it.

set -eu

bin="$HOME/.local/bin"
tab=$(printf '\t')

# Print "script<TAB>icon  Name >" for the installed scripts.
lines() {
    local s
    for s in 'wifi	  Wifi >' \
        'volume	󰕾  Volume >' \
        'bluetooth	  Bluez >' \
        'vpn	󰖂  VPN >' \
        'settings	󰒓  Prefs >' \
        'power	  Power >'; do
        [ ! -x "$bin/${s%%"$tab"*}" ] || printf '%s\n' "$s"
    done
}

# Print the banner of a menu.
#
# The font is Bloody (patorjk.com), like the fastfetch logo. Bloody has
# no lowercase, so it is drawn by hand. Where the window is too narrow the
# word is shorter: bluetooth = bluez, settings = prefs, services = svc.
art() {
    case "$1" in
        menu) cat <<'EOF'
 ██▄██▄ ▄██▄     ▄███▄    ██▄██▄    ██   ██
▓██▀ ▀███▀▀██▒ ▓██▀ ▀██▒ ▓██▀ ▀██▒ ▓██  ▓██▒
▓██   ▓██  ██▒ ▒███▀▀▀   ▓██   ██▒ ▓▓█  ▒██░
▒██▒  ▒██  ██░ ░▒████▄▒  ▒██░  ██░ ▒▒████▓█▄
░ ▒░  ░ ▒  ▒ ░ ░░ ▒░ ░   ░ ▒░  ▒ ░ ░▒▓▒ ▒ ▒
░  ░  ░ ░  ░ ░  ░ ░  ░   ░ ░░  ░ ░ ░░▒░ ░ ░
░     ░    ░      ░         ░  ░    ░░░ ░ ░
      ░           ░  ░         ░      ░
EOF
            ;;
        wifi) cat <<'EOF'
              ▀▀    ▄███▒  ▀▀
▓█▓  ▄  ▓█▓   ▄▄   ▓██▀    ▄▄
▒██ ▐█▌ ██▒  ▓██▒ ▒████▒  ▓██▒
░██▄███▄██░  ▒██░ ░▓██░   ▒██░
 ▀██▀ ▀██▀   ░██░ ░▒██░   ░██░
 ░▓░ ▒ ▒░    ░▓    ▒▓░    ░▓
  ▒ ░ ░ ░     ▒ ░  ░▒      ▒ ░
  ░   ░       ░     ░      ░
    ░         ░     ░      ░
EOF
            ;;
        volume) cat <<'EOF'
                   ▓██
▓██   █▓  ▄████▄   ▒██    ██   ██   ██▄██▄ ▄██▄     ▄███▄
▒██░ ██▒ ▒██▀ ▀██▒ ▒██░  ▓██  ▓██▒ ▓██▀ ▀███▀▀██▒ ▓██▀ ▀██▒
 ▓██ █░  ▒██   ██░ ░██░  ▓▓█  ▒██░ ▓██   ▓██  ██▒ ▒███▀▀▀
  ▀██▀   ░▀████▓▀  ░▓██▄ ▒▒████▓█▄ ▒██▒  ▒██  ██░ ░▒████▄▒
  ░▐░    ░ ▒░▒░▒░  ░▒▓ ░ ░▒▓▒ ▒ ▒  ░ ▒░  ░ ▒  ▒ ░ ░░ ▒░ ░
  ░░       ░ ▒ ▒░   ░▒   ░░▒░ ░ ░  ░  ░  ░ ░  ░ ░  ░ ░  ░
   ░     ░ ░ ░      ░     ░░░ ░ ░  ░     ░    ░      ░
  ░          ░        ░     ░            ░           ░  ░
EOF
            ;;
        bluetooth) cat <<'EOF'
 ██▓      ▓██
▓██▒▄██▄  ▒██    ██   ██    ▄███▄   ▒██████▒
▒██▀  ▀██ ▒██░  ▓██  ▓██▒ ▓██▀ ▀██▒ ░ ▒ ▄█▀░
░██▄  ▄██ ░██░  ▓▓█  ▒██░ ▒███▀▀▀     ▄█▀▒ ░
░▓█▒███▀  ░▓██▄ ▒▒████▓█▄ ░▒████▄▒  ▒██████▒
░▒▓▒░ ░   ░▒▓ ░ ░▒▓▒ ▒ ▒  ░░ ▒░ ░   ░▒▒ ▓░▒░
▒░▒ ░ ░    ░▒   ░░▒░ ░ ░   ░ ░  ░   ░░▒ ▒ ░
 ░  ░      ░     ░░░ ░ ░     ░      ░ ░ ░ ░
 ░           ░     ░         ░  ░     ░
EOF
            ;;
        vpn) cat <<'EOF'
▓██   █▓ ▓██▄██▄    ██▄██▄
▒██░ ██▒ ▓██▀ ▀██▒ ▓██▀ ▀██▒
 ▓██ █░  ▒██▄ ▄██░ ▓██   ██▒
  ▀██▀   ▒██▀██▀   ▒██░  ██░
  ░▐░    ▒██░      ░ ▒░  ▒ ░
  ░░     ░▓█░      ░ ░░  ░ ░
   ░      ░▒ ░        ░  ░
  ░        ░             ░
EOF
            ;;
        light) cat <<'EOF'
▓██    ▀▀             ██▓       ▄██
▒██    ▄▄   ▄████▄▄  ▓██▒▄██▄  ▓█████▒
▒██░  ▓██▒ ▓██▀ ▀██▒ ▒██▀ ▀██▒  ▓██
░██░  ▒██░ ▒██▄ ▄██░ ░██  ░██░  ▒██
░▓██▄ ░██░  ▀█████▓  ░▓█▒ ░██▓  ░▀██▄▒
░▒▓ ░ ░▓    ▄▄  ▓██   ▒ ░ ▒░▒    ▒ ░░
 ░▒    ▒ ░  ▀████▀    ▒ ░ ░ ░    ░ ░
 ░     ░     ░▒ ░     ░   ░        ░
   ░   ░      ░       ░     ░    ░
EOF
            ;;
        settings) cat <<'EOF'
                              ▄███▒
▓██▄██▄    ██▄██▄   ▄███▄    ▓██▀    ▄████▒
▓██▀ ▀██▒ ▓██▀ ▀▀ ▓██▀ ▀██▒ ▒████▒  ▒██▄  ▀
▒██▄ ▄██░ ▓██     ▒███▀▀▀   ░▓██░    ▀▀███▄
▒██▀██▀   ▒██░    ░▒████▄▒  ░▒██░   ▒██████▒
▒██░      ░ ▒▓    ░░ ▒░ ░    ▒▓░    ▒ ▒▓▒ ▒
░▓█░        ░▒ ░   ░ ░  ░    ░▒     ░ ░▒  ░
 ░▒ ░       ░        ░        ░     ░  ░
  ░          ░       ░  ░     ░          ░
EOF
            ;;
        services) cat <<'EOF'
 ▄████▒  ▓██   █▓  ▄████▄
▒██▄  ▀  ▒██░ ██▒ ▒██▀ ▀█
 ▀▀███▄   ▓██ █░  ▒▓█    ▄
▒██████▒   ▀██▀   ▒ ▓███▀ ░
▒ ▒▓▒ ▒    ░▐░    ░ ░▒ ▒  ░
░ ░▒  ░    ░░       ░  ▒
░  ░        ░     ░
     ░     ░      ░ ░
EOF
            ;;
        power) cat <<'EOF'
▓██▄██▄    ▄████▄   ▓█▓  ▄  ▓█▓    ▄███▄    ██▄██▄
▓██▀ ▀██▒ ▒██▀ ▀██▒ ▒██ ▐█▌ ██▒  ▓██▀ ▀██▒ ▓██▀ ▀▀
▒██▄ ▄██░ ▒██   ██░ ░██▄███▄██░  ▒███▀▀▀   ▓██
▒██▀██▀   ░▀████▓▀   ▀██▀ ▀██▀   ░▒████▄▒  ▒██░
▒██░      ░ ▒░▒░▒░   ░▓░ ▒ ▒░    ░░ ▒░ ░   ░ ▒▓
░▓█░        ░ ▒ ▒░    ▒ ░ ░ ░     ░ ░  ░     ░▒ ░
 ░▒ ░     ░ ░ ░       ░   ░         ░        ░
  ░           ░         ░           ░  ░      ░
EOF
            ;;
    esac
}

# Print the width of TEXT. 'wc -m' counts characters, '${#var}' counts
# bytes in dash.
chars() {
    printf '%s' "$1" | wc -m
}

# Move stdin to the middle of fzf (FZF_COLUMNS): pad WIDTH.
#
# The 4 is the border and the cursor column, like center() in shh.
pad() {
    local p=$(( (${FZF_COLUMNS:-0} - 4 - $1) / 2 ))
    [ "$p" -gt 0 ] || p=0
    sed "s/^/$(printf '%*s' "$p" '')/"
}

# Print the header of a menu: an empty line, the banner, an empty line
# and '$MENU_TEXT', all in the middle.
#
# fzf runs this when the list is ready and on every resize (sway sets the
# width after the window opens). The menus bind it to 'result,resize',
# not to 'load': their own 'load:pos(N)' would replace it.
header() {
    local a l w=0
    a=$(art "$1")
    while IFS= read -r l; do
        [ "$(chars "$l")" -le "$w" ] || w=$(chars "$l")
    done <<EOF
$a
EOF
    echo ' '
    printf '%s\n' "$a" | pad "$w"
    echo ' '
    [ -n "${MENU_TEXT:-}" ] || return 0
    printf '%s\n' "$MENU_TEXT" | while IFS= read -r l; do
        printf '%s\n' "$l" | pad "$(chars "$l")"
    done
}

# Give the floating window of fzf ROWS rows, keeping its top in place.
#
# 'resize set' keeps the middle, so the window is moved back: rows come
# and go at the bottom. The height of a row is taken from the window:
# 16 is 'pad=8x8' in foot.ini, 2 is the sway border. Our own resize runs
# the header again, then the rows match and it stops.
fit() {
    local win id x y h bottom px
    [ "${FZF_LINES:-0}" -gt 0 ] && [ "$1" -ne "$FZF_LINES" ] || return 0
    win=$(swaymsg -t get_tree | jq -r '.. | objects | select(.type == "workspace") | .rect as $ws
        | .floating_nodes[]? | select(.focused)
        | "\(.id) \(.rect.x) \(.rect.y) \(.window_rect.height) \($ws.y + $ws.height)"' 2>/dev/null) || return 0
    [ -n "$win" ] || return 0
    read -r id x y h bottom <<EOF
$win
EOF
    px=$(( (h - 16) / FZF_LINES * $1 + 18 ))
    # A long list scrolls instead of going off the screen.
    [ "$((y + px))" -le "$bottom" ] || px=$((bottom - y))
    swaymsg "[con_id=$id] resize set height $px px, move absolute position $x px $y px" >/dev/null 2>&1 || true
}

case "${1:-}" in
    # The rows: the header, the lines and one empty line at the bottom.
    --header)
        out=$(header "${2:-menu}")
        printf '%s\n' "$out"
        fit $(( $(printf '%s\n' "$out" | wc -l) + ${FZF_TOTAL_COUNT:-0} + 1 ))
        exit 0 ;;
    # Close the menu if it is open ('kill' fails with 2 when there is
    # none), else open it as tall as this menu (the header is 10 rows).
    # sway/rules sets the width.
    open)
        swaymsg '[app_id="menu"] kill' >/dev/null 2>&1 && exit 0
        exec footclient --app-id=menu --window-size-chars="50x$(($(lines | wc -l) + 11))" "$0" ;;
esac

# No text under the banner here. A menu opened from here sets its own.
export MENU_TEXT=

# 'pos' keeps the cursor on the last picked line.
pos=1
while :; do
    list=$(lines)
    pick=$(printf '%s\n' "$list" |
        fzf --info=hidden --no-input --border=none --delimiter="$tab" --with-nth=2 \
            --bind="result,resize:transform-header:sh '$0' --header menu" --bind="load:pos($pos)") || exit 0
    pos=$(printf '%s\n' "$list" | grep -nxF -- "$pick" | cut -d: -f1)
    # A menu that fails (no wifi device) just comes back here.
    "$bin/${pick%%"$tab"*}" || true
done
