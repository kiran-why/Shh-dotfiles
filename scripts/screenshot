#!/bin/sh
# Save a region to ~/media/screenshots and copy it (Print).
# 'screenshot full' takes all screens, with no selecting (Shift+Print).

set -eu

dir="$HOME/media/screenshots"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

mkdir -p "$dir"
if [ "${1:-}" = full ]; then
    grim "$file"
else
    # '-b' is the dim, '-c' the border color, '-w' the border width.
    # Without '</dev/null' slurp waits for boxes on stdin.
    geometry=$(slurp -b '#00000080' -c '#e6e6e6ff' -w 1 </dev/null) || exit 0
    grim -g "$geometry" "$file"
fi
wl-copy --type image/png <"$file"
~/.local/bin/notify -a screenshot 'screenshot saved and copied' "${file##*/}" || true
