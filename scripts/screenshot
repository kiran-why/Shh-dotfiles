#!/bin/sh
# screenshot - save a region to ~/media/screenshots and copy it (Print)
# screenshot full: all screens, no selecting (Shift+Print)

set -eu

dir="$HOME/media/screenshots"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

mkdir -p "$dir"
if [ "${1:-}" = full ]; then
    grim "$file"
else
    # -b dim, -c border color, -w border width; without </dev/null slurp
    # waits for boxes on stdin
    geometry=$(slurp -b '#00000080' -c '#e6e6e6ff' -w 1 </dev/null) || exit 0
    grim -g "$geometry" "$file"
fi
wl-copy --type image/png <"$file"
notify-send -a screenshot 'screenshot saved and copied' "${file##*/}" || true
