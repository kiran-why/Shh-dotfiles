#!/bin/sh
# Lock the screen and turn the screens off ($mod+Escape). Again while
# locked: the screens go on. The password can be typed with them off too.
#
# There is no swayidle (on Artix it needs elogind), so this script turns
# the screens on after the unlock.

set -eu

# Locked already (the key is '--locked'): only turn the screens on, no
# second swaylock.
if pgrep -x swaylock >/dev/null; then
    swaymsg 'output * power on' >/dev/null
    exit 0
fi

swaylock &
swaymsg 'output * power off' >/dev/null
# 'wait' returns when swaylock exits, that is after the unlock.
wait $! || true
swaymsg 'output * power on' >/dev/null
