#!/bin/sh
# wallpaper - the newest picture in ~/wallpapers, black if none
# runs on every sway reload ($mod+Shift+c)

set -eu

dir="$HOME/wallpapers"

pic=$(ls -t "$dir"/*.png "$dir"/*.PNG "$dir"/*.jpg "$dir"/*.JPG \
    "$dir"/*.jpeg "$dir"/*.JPEG 2>/dev/null | head -n 1) || true

# fill keeps proportions (also: fit, center, stretch, tile)
if [ -n "$pic" ]; then
    swaymsg "output * bg \"$pic\" fill #000000" >/dev/null
else
    swaymsg 'output * bg #000000 solid_color' >/dev/null
fi
