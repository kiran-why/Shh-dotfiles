#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

#  ▄▄▄ █▄▄  █▄▄  
# ▀▀▄▄ █  █ █  █ 
# ▀▀▀  ▀  ▀ ▀  ▀ 
# shh - look after the dotfiles: update, check, change a color, uninstall
# usage: shh update | doctor | color OLD NEW | uninstall [-n] | help

set -eu

# link.sh puts lib.sh, services.txt and packages/ here, so the repo can go
share="$HOME/.local/share/shh"
list="$HOME/.local/state/shh/installed"
repo_url="https://github.com/kiran-why/Shh-dotfiles.git"
tab=$(printf '\t')

[ -f "$share/lib.sh" ] || { echo "lib.sh not found in $share, run sh link.sh from the repo" >&2; exit 1; }
. "$share/lib.sh"

usage() {
    echo "usage: shh COMMAND"
    echo "  update   install.sh from a fresh clone (it updates the system and the configs)"
    echo "  doctor   check services, installed files, packages and the session"
    echo "  color OLD NEW  change a color in every config, e.g. shh color d7263d ff0000"
    echo "  uninstall [-n] remove what link.sh put in place, put the old files back (-n: only show)"
    echo "  help     show this help"
}

# █  █ █▀▀▄ █▀▀▄ ▄▀▀▄ ▀▀█▀▀ █▀▀▀ 
# █  █ █▀▀  █  █ █▀▀█   █   █▀▀  
#  ▀▀  ▀    ▀▀▀  ▀  ▀   ▀   ▀▀▀▀ 

update() {
    local repo tmp

    # installed with --link: update the repo the links point to
    if [ -L "$share/lib.sh" ]; then
        repo=$(cd "$(dirname "$(readlink -f "$share/lib.sh")")" && pwd -P)
        step "updating the repo: $repo"
        git -C "$repo" pull --ff-only ||
            error "git pull failed (local changes? see git -C $repo status)"
        # exec: git pull may have replaced this very file
        exec sh "$repo/install.sh"
    fi

    tmp=$(mktemp -d) || error "cannot make a temporary folder"
    trap 'rm -rf "$tmp"' EXIT
    step "downloading $repo_url"
    git clone --depth 1 "$repo_url" "$tmp" || error "git clone failed"
    sh "$tmp/install.sh"
}

# █▀▀▄ ▄▀▀▄ ▄▀▀▀ ▀▀█▀▀ ▄▀▀▄ █▀▀▄ 
# █  █ █  █ █      █   █  █ █▀█  
# ▀▀▀   ▀▀   ▀▀▀   ▀    ▀▀  ▀  ▀ 

problems=0

# bad TEXT: a warning that counts as a problem
bad() {
    warn "$1"
    problems=$((problems + 1))
}

# every part of each service must be up (iwd = iwd-srv + iwd-log)
check_services() {
    step "s6 services (services.txt)"

    local active svc parts part down
    active=$(s6-rc -a list 2>/dev/null) || {
        bad "cannot read the s6 state (s6-rc -a list)"
        return 0
    }

    for svc in $(read_list "$share/services.txt"); do
        parts=$(s6-rc list "$svc" 2>/dev/null) || {
            bad "$svc: unknown to s6, run sh install.sh"
            continue
        }
        down=""
        for part in $parts; do
            printf '%s\n' "$active" | grep -qxF "$part" || down="$down $part"
        done
        if [ -z "$down" ]; then
            ok "$svc"
        else
            bad "$svc is not running:$down"
        fi
    done
}

# every file from the list is there (a broken link counts as missing)
check_files() {
    step "files"

    [ -f "$list" ] || { bad "no $list (sh link.sh)"; return 0; }
    local k dst n=0 found=0
    while IFS="$tab" read -r k dst; do
        n=$((n + 1))
        [ -e "$dst" ] || { bad "missing: $dst (sh link.sh)"; found=1; }
    done <"$list"
    [ "$found" = 1 ] || ok "all $n files in place"
}

# common.csv + packages/CARD.csv, like install.sh
check_packages() {
    step "packages"

    local hw csv names missing pkg
    names=$(for hw in common $(sh "$HOME/.local/bin/hardware" 2>/dev/null || true); do
        csv="$share/packages/$hw.csv"
        [ ! -f "$csv" ] || read_list "$csv" | cut -d, -f2
    done)

    # pacman -T prints the missing ones
    missing=$(pacman -T $names || true)

    for pkg in $missing; do
        bad "not installed: $pkg (sh install.sh)"
    done
    [ -n "$missing" ] || ok "all $(printf '%s\n' "$names" | wc -l) packages installed"
}

# what sway needs without elogind
check_session() {
    step "session"

    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
        ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    else
        bad "XDG_RUNTIME_DIR is not set (pam_rundir in /etc/pam.d/system-login)"
    fi

    # id -nG USER: /etc/group; id -nG: this login (needs a relogin to change)
    local user group
    user=$(id -un)
    for group in seat audio; do
        if ! id -nG "$user" | tr ' ' '\n' | grep -qx "$group"; then
            bad "$user is not in group $group (sh install.sh)"
        elif ! id -nG | tr ' ' '\n' | grep -qx "$group"; then
            bad "group $group: log out and in again"
        else
            ok "group $group"
        fi
    done
}

doctor() {
    check_services
    check_files
    check_packages
    check_session

    echo
    [ "$problems" -eq 0 ] || error "$problems problem(s)"
    ok "all good"
}

# ▄▀▀▀ ▄▀▀▄ █    ▄▀▀▄ █▀▀▄ 
# █    █  █ █    █  █ █▀█  
#  ▀▀▀  ▀▀  ▀▀▀▀  ▀▀  ▀  ▀ 

# the palette lives in each program's own config; config/foot/foot.ini lists it.
# Edits the installed files: with --link that is the repo, with copies
# the next update puts the repo colors back (yours stay in .bak files)
color() {
    [ "$#" -eq 2 ] || { usage >&2; exit 1; }
    [ -f "$list" ] || error "no $list (sh link.sh)"

    local old new files c k f
    old=$(printf '%s' "${1#\#}" | tr 'A-F' 'a-f')
    new=$(printf '%s' "${2#\#}" | tr 'A-F' 'a-f')
    for c in "$old" "$new"; do
        printf '%s' "$c" | grep -qx '[0-9a-f]\{6\}' || error "not a color: $c (6 hex digits, like e6e6e6)"
    done

    # configs and scripts; not shh itself (its help has a color in it)
    files=$(while IFS="$tab" read -r k f; do
        case "$f" in "$share"/*|*/shh) continue ;; esac
        printf '%s\n' "$f"
    done <"$list")

    # from now on both are one color: changing it later changes both
    ! printf '%s\n' "$files" | xargs -r -d '\n' grep -qiI -- "$new" || warn "$new is already used too"

    files=$(printf '%s\n' "$files" | xargs -r -d '\n' grep -liI -- "$old" || true)
    [ -n "$files" ] || error "$old is not used in the configs"

    # --follow-symlinks: with --link, edit the repo file, keep the link
    printf '%s\n' "$files" | while IFS= read -r f; do
        sed -i --follow-symlinks "s/$old/$new/gI" "$f"
        ok "$f"
    done
    info "to see it: Super+Shift+C (sway, bar), makoctl reload, new foot and nvim windows"
}

# █▄ ▄█ ▄▀▀▄ ▀█▀ █▄  █ 
# █ ▀ █ █▀▀█  █  █ ▀▄█ 
# ▀   ▀ ▀  ▀ ▀▀▀ ▀   ▀ 

[ "$(id -u)" -ne 0 ] || error "do not run as root, run as your user"

case "${1:-}" in
    update)         update ;;
    doctor)         doctor ;;
    color)          shift; color "$@" ;;
    uninstall)      shift; exec sh "$share/link.sh" --uninstall "$@" ;;
    help|-h|--help) usage ;;
    "")             usage >&2; exit 1 ;;
    *)              usage >&2; error "unknown command: $1" ;;
esac
