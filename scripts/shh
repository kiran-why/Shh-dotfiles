#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

#  ▄▄▄ █▄▄  █▄▄  
# ▀▀▄▄ █  █ █  █ 
# ▀▀▀  ▀  ▀ ▀  ▀ 
# shh - look after the dotfiles: pick the parts, update, check, change a color, uninstall
# usage: shh config | update | doctor | color OLD NEW | uninstall [-n] | help

set -eu

# where link.sh installs lib.sh, link.sh, the lists and packages/, so the repo can go
share="$HOME/.local/share/shh"
list="$HOME/.local/state/shh/installed"
repo_url="https://github.com/kiran-why/Shh-dotfiles.git"
tab=$(printf '\t')

# what shh reads: the installed copies. Started from the repo (sh scripts/shh
# config, install.sh): its files, they can be newer than $share;
# ~/.local/bin/shh finds no lib/lib.sh in ~/.local
repo=$(cd "$(dirname "$0")/.." && pwd -P)
from_repo=0
[ ! -f "$repo/lib/lib.sh" ] || from_repo=1

if [ "$from_repo" = 1 ]; then lib_file="$repo/lib/lib.sh"; else lib_file="$share/lib.sh"; fi
[ -f "$lib_file" ] || { echo "lib.sh not found: $lib_file, run sh lib/link.sh from the repo" >&2; exit 1; }
. "$lib_file"

# the repo has a folder per distro ($distro: lib.sh), share only this one's
if [ "$from_repo" = 1 ]; then
    link_file="$repo/lib/link.sh"
    components_file="$repo/components/${distro}_components.txt"
    services_file="$repo/system/$distro/services.txt"
    packages_dir="$repo/system/$distro/packages"
    distro_file="$repo/system/$distro/distro.sh"
else
    link_file="$share/link.sh"
    components_file="$share/components.txt"
    services_file="$share/services.txt"
    packages_dir="$share/packages"
    distro_file="$share/distro.sh"
fi
# scripts/hardware: what the machine is (cards)
if [ "$from_repo" = 1 ]; then hardware_script="$repo/scripts/hardware"; else hardware_script="$HOME/.local/bin/hardware"; fi

# pkg_*, svc_check, seat_groups; missing: only doctor and installing fzf need it
[ ! -f "$distro_file" ] || . "$distro_file"

usage() {
    echo "usage: shh COMMAND"
    echo "  config   pick the parts and settings for install.sh (then: shh update)"
    echo "  update   install.sh from a fresh clone (it updates the system and the configs)"
    echo "  doctor   check services, installed files, packages and the session"
    echo "  color OLD NEW  change a color in every config, e.g. shh color d7263d ff0000"
    echo "  uninstall [-n] remove what link.sh put in place, put the old files back (-n: only show)"
    echo "  help     show this help"
}

# ▄▀▀▀ ▄▀▀▄ █▄  █ █▀▀▀ ▀█▀ ▄▀▀▀ 
# █    █  █ █ ▀▄█ █▀▀   █  █ ▀█ 
#  ▀▀▀  ▀▀  ▀   ▀ ▀    ▀▀▀  ▀▀▀ 

# choices for the small menus: "value<TAB>shown text"
modes="copy${tab}Copy   copies, the repo can be deleted
link${tab}Link   links to the repo, edits land in it"
# the same look, options and keys in both (config/vim, config/nvim)
editors="vim${tab}Vim      fewer dependencies
nvim${tab}Neovim"
file_managers="broot${tab}Broot    folders as a tree
yazi${tab}Yazi     previews, tabs"
# xkb options for switching the layout
toggles="alt_shift_toggle${tab}Alt+Shift
ctrl_shift_toggle${tab}Ctrl+Shift
win_space_toggle${tab}Super+Space
caps_toggle${tab}Caps Lock
lalt_lshift_toggle${tab}Left Alt+Left Shift"
# DNS servers, comma-separated (install.sh: /etc/resolvconf.conf); others: by hand in $shh_config
dns_list="dhcp${tab}DHCP         from the network
1.1.1.1,1.0.0.1${tab}Cloudflare   1.1.1.1
9.9.9.9,149.112.112.112${tab}Quad9        9.9.9.9
8.8.8.8,8.8.4.4${tab}Google       8.8.8.8"

# copies or links now: link.sh keeps what is installed
if [ -L "$HOME/.local/share/shh/lib.sh" ]; then mode_now=link; else mode_now=copy; fi

# set_value NAME VALUE: change NAME in $shh_config, or add it
set_value() {
    if grep -q "^$1=" "$shh_config"; then
        sed -i "s|^$1=.*|$1=$2|" "$shh_config"
    else
        printf '%s=%s\n' "$1" "$2" >>"$shh_config"
    fi
}

# toggle NAME [DEFAULT]: yes <-> no; DEFAULT when NAME is not set (yes)
toggle() {
    local default="${2:-yes}"
    if [ "$(setting "$1" "$default")" = yes ]; then set_value "$1" no; else set_value "$1" yes; fi
    note="$(cap "$1"): $(setting "$1" "$default")"
}

# lines are "key<TAB>text": only the text shows, the key says what was picked
menu() {
    fzf --info=hidden --no-input --delimiter="$tab" --with-nth=2 "$@"
}

# cap TEXT: TEXT with a capital first letter (menus show it so, the keys stay)
cap() {
    printf '%s%s' "$(printf '%.1s' "$1" | tr '[:lower:]' '[:upper:]')" "${1#?}"
}

# line KEY BOX LABEL TEXT: a menu line
line() {
    printf '%s\t%-3s %-14s %s\n' "$1" "$2" "$(cap "$3")" "$4"
}

# yes_no NAME TEXT [DEFAULT]: a line with [x] or [ ]
yes_no() {
    if [ "$(setting "$1" "${3:-yes}")" = yes ]; then line "$1" '[x]' "$1" "$2"; else line "$1" '[ ]' "$1" "$2"; fi
}

# label_of LIST KEY: the shown text of KEY in LIST
label_of() {
    printf '%s\n' "$1" | awk -F "$tab" -v k="$2" '$1 == k { print $2 }'
}

# choose LABEL LIST: pick one, print its key (nothing on Esc)
choose() {
    printf '%s\n' "$2" | menu --border-label=" $(cap "$1") " | cut -f1
}

# center TEXT [WIDTH]: TEXT in the middle of the menu (window width minus the
# border and the cursor column); with no terminal as it is. WIDTH: for
# non-ASCII text, dash counts bytes in ${#1}
center() {
    local cols pad
    cols=$(stty size 2>/dev/null </dev/tty | cut -d" " -f2)
    pad=$(( (${cols:-0} - 4 - ${2:-${#1}}) / 2 ))
    [ "$pad" -gt 0 ] || pad=0
    printf '%*s%s\n' "$pad" '' "$1"
}

# loop LABEL HEADER LINES ACT [ART]: a menu that stays open. LINES prints the
# lines, ACT KEY does the change and may set $note. ART goes above HEADER,
# under an empty line. Esc leaves
loop() {
    local lines pick header pos=1
    note=''
    while :; do
        lines=$("$3")
        # a last line of one space: an empty line above the list
        header=$([ -z "${5:-}" ] || printf ' \n%s\n' "$5"; center "$2"; [ -z "$note" ] || center "$note"; echo ' ')
        pick=$(printf '%s\n' "$lines" |
            menu --border-label=" $(cap "$1") " --header="$header" --bind="load:pos($pos)") || return 0
        pos=$(printf '%s\n' "$lines" | grep -nxF -- "$pick" | cut -d: -f1)
        "$4" "${pick%%"$tab"*}"
    done
}

top_lines() {
    line settings '' settings 'Install options >'
    line features '' features 'Desktop tools >'
    # an empty line between the two groups; Enter on it does nothing
    printf -- '-\t\n'
    line misc '' misc 'Additional packages >'
}

top_act() {
    case "$1" in
        settings)
            loop settings 'Enter: change   Esc: back' settings_lines settings_act ;;
        features|misc)
            # features: the parts with no group
            tab_group=$1
            [ "$1" != features ] || tab_group=''
            loop "$1" 'Enter: on / off   Esc: back' group_lines group_act ;;
    esac
    note=''
}

settings_lines() {
    line mode '' mode "$(setting mode "$mode_now") >"
    line layouts '' layouts "$(setting layouts us,ru) >"
    line layout_toggle '' 'switch layout' "$(label_of "$toggles" "$(setting layout_toggle alt_shift_toggle)") >"
    line dns '' dns "$(setting dns dhcp) >"
    line gpu '' graphics "$(setting gpu auto) >"
    line editor '' editor "$(setting editor vim) >"
    line files '' 'file manager' "$(setting files broot) >"
    # distro_settings: distro.sh (Artix: aur helper, pacman)
    ! command -v distro_settings >/dev/null || distro_settings
    yes_no nobeep 'Mute the motherboard beeper'
    yes_no maxhz 'Highest refresh rate of every screen'
    yes_no xwayland 'X11 programs; after a relogin' no
    yes_no a11y 'Screen readers in GTK programs; after a relogin' no
}

settings_act() {
    local value
    case "$1" in
        mode)          value=$(choose mode "$modes") ;;
        layout_toggle) value=$(choose 'switch layout' "$toggles") ;;
        dns)           value=$(choose dns "$dns_list") ;;
        editor)        value=$(choose editor "$editors") ;;
        files)         value=$(choose 'file manager' "$file_managers") ;;
        gpu)
            loop graphics "Enter: on / off   Esc: back   found: $(found_cards | sed 's/,/, /g')" gpu_lines gpu_act
            note="Graphics: $(setting gpu auto)"
            return 0 ;;
        layouts)
            loop layouts 'Enter: on / off   Esc: back   the first one is the default' layout_lines layout_act
            note="Layouts: $(setting layouts us,ru)"
            return 0 ;;
        xwayland|a11y)
            toggle "$1" no
            return 0 ;;
        *)
            # distro_act: distro.sh (Artix: aur helper); not its line: a yes / no
            if ! command -v distro_act >/dev/null || ! value=$(distro_act "$1"); then
                toggle "$1"
                return 0
            fi ;;
    esac
    [ -n "$value" ] || return 0
    set_value "$1" "$value"
    note="$(cap "$1"): $value"
}

# group GROUP: "name|default" of the parts in GROUP (components.txt)
group() {
    read_list "$components_file" | awk -F'|' -v g="$1" '$5 == g { print $1 "|" $6 }'
}

# the tab of $tab_group: a line per part, Enter turns it on / off
group_lines() {
    local name default
    group "$tab_group" | while IFS='|' read -r name default; do
        yes_no "$name" '' "${default:-yes}"
    done
}

group_act() {
    toggle "$1" "$(group "$tab_group" | awk -F'|' -v n="$1" '$1 == n { print $2 }')"
}

# every xkb layout as "code<TAB>name"; before the install there is no
# evdev.lst yet (it comes with sway), so a short list
all_layouts() {
    local lst=/usr/share/X11/xkb/rules/evdev.lst
    if [ -f "$lst" ]; then
        awk '/^! layout/ { f = 1; next } /^!/ { f = 0 }
            f && NF { c = $1; $1 = ""; sub(/^ +/, ""); print c "\t" $0 }' "$lst"
        return
    fi
    printf '%s\n' "us${tab}English (US)" "gb${tab}English (UK)" "ru${tab}Russian" \
        "ua${tab}Ukrainian" "by${tab}Belarusian" "kz${tab}Kazakh" "de${tab}German" \
        "fr${tab}French" "es${tab}Spanish" "it${tab}Italian" "pl${tab}Polish" \
        "pt${tab}Portuguese" "tr${tab}Turkish" "cz${tab}Czech"
}

# the layouts turned on first, in their order, then the rest
layout_lines() {
    all_layouts | awk -F "$tab" -v now="$(setting layouts us,ru)" '
        { name[$1] = $2; order[++n] = $1 }
        END {
            k = split(now, on, ",")
            for (i = 1; i <= k; i++) { printf "%s\t[x] %-14s %s\n", on[i], on[i], name[on[i]]; used[on[i]] }
            for (i = 1; i <= n; i++)
                if (!(order[i] in used)) printf "%s\t[ ] %-14s %s\n", order[i], order[i], name[order[i]]
        }'
}

# found_cards: the cards scripts/hardware finds, as the choices below
# (amd,nvidia); "nothing" in a VM or with no card
found_cards() {
    local cards
    cards=$(sh "$hardware_script" 2>/dev/null |
        sed 's/^nvidia-580xx$/nvidia/; s/^nvidia-legacy$/nouveau/' |
        grep -x 'amd\|intel\|nvidia\|nouveau' | paste -sd, -) || true
    printf '%s\n' "${cards:-nothing}"
}

# graphics: auto, or the drivers picked by hand (gpu=amd,nvidia; gpu_drivers: lib.sh)
gpu_lines() {
    local now card label text
    now=$(setting gpu auto)
    if [ "$now" = auto ]; then line auto '[x]' auto 'By the card, recommended'
    else line auto '[ ]' auto 'By the card, recommended'; fi
    for card in amd intel nvidia nouveau; do
        case "$card" in
            amd)     label=AMD;     text='' ;;
            intel)   label=Intel;   text='' ;;
            nvidia)  label=NVIDIA;  text='The NVIDIA driver' ;;
            nouveau) label=Nouveau; text='The free NVIDIA driver' ;;
        esac
        case ",$now," in
            *",$card,"*) line "$card" '[x]' "$label" "$text" ;;
            *)           line "$card" '[ ]' "$label" "$text" ;;
        esac
    done
}

# gpu_act KEY: auto; or a card on <-> off, starting from the cards found.
# The NVIDIA driver and nouveau can't be both; none left = auto
gpu_act() {
    local now
    if [ "$1" = auto ]; then
        set_value gpu auto
        note="Graphics: auto"
        return 0
    fi
    now=$(setting gpu auto)
    if [ "$now" = auto ]; then
        now=$(found_cards)
        [ "$now" != nothing ] || now=''
    fi
    case ",$now," in
        *",$1,"*) now=$(printf '%s\n' "$now" | tr , '\n' | grep -vxF -- "$1" | paste -sd, -) ;;
        *)
            case "$1" in
                nvidia)  now=$(printf '%s\n' "$now" | tr , '\n' | grep -vx nouveau | paste -sd, -) ;;
                nouveau) now=$(printf '%s\n' "$now" | tr , '\n' | grep -vx nvidia | paste -sd, -) ;;
            esac
            now="${now:+$now,}$1" ;;
    esac
    set_value gpu "${now:-auto}"
    note="Graphics: ${now:-auto}"
}

# layout_act CODE: on -> off (one has to stay), off -> on at the end
layout_act() {
    local now
    now=$(setting layouts us,ru)
    case ",$now," in
        *",$1,"*)
            if [ "$now" = "$1" ]; then
                note="One layout has to stay"
                return 0
            fi
            now=$(printf '%s\n' "$now" | tr ',' '\n' | grep -vxF -- "$1" | paste -sd, -) ;;
        *)
            now="$now,$1" ;;
    esac
    set_value layouts "$now"
    note="Layouts: $now"
}

# shh config: tabs settings, features, misc;
# every change goes to $shh_config at once
config() {
    [ -f "$components_file" ] || error "not found: $components_file (sh lib/link.sh)"
    command -v fzf >/dev/null || pkg_install "" fzf || error "cannot install fzf"
    # the look of every menu; .zprofile sets it only after the install
    if [ -z "${FZF_DEFAULT_OPTS_FILE:-}" ] && [ -f "$repo/config/fzf/fzfrc" ]; then
        export FZF_DEFAULT_OPTS_FILE="$repo/config/fzf/fzfrc"
    fi

    mkdir -p "${shh_config%/*}"
    if [ ! -f "$shh_config" ]; then
        printf '%s\n' \
            '# ~/.config/shh/config - your choices for install.sh and shh update' \
            '# change: shh config, then shh update (or edit here); a missing line = the default' \
            >"$shh_config"
    fi

    # font Bloody (patorjk.com), like the fastfetch logo, N made narrower; 47 columns wide
    art=$(while IFS= read -r l; do center "$l" 47; done <<'EOF'
 ▄████▄   ▒█████   ███▄  █   █████▒ ██▓  ▄████
▒██▀ ▀█  ▒██▒  ██▒ ██ ▀█ █ ▓██   ▒ ▓██▒ ██▒ ▀█▒
▒▓█    ▄ ▒██░  ██▒▓██  ▀██▒▒████ ░ ▒██▒▒██░▄▄▄░
▒▓▓▄ ▄██▒▒██   ██░▓██▒ ▐██▒░▓█▒  ░ ░██░░▓█  ██▓
▒ ▓███▀ ░░ ████▓▒░▒██░  ██░░▒█░    ░██░░▒▓███▀▒
░ ░▒ ▒  ░░ ▒░▒░▒░ ░ ▒░  ▒ ▒ ▒ ░    ░▓   ░▒   ▒
  ░  ▒     ░ ▒ ▒░ ░ ░░  ░ ▒ ░       ▒ ░  ░   ░
░        ░ ░ ░ ▒     ░  ░ ░ ░ ░     ▒ ░░ ░   ░
░ ░          ░ ░          ░         ░        ░
░
EOF
)
    loop 'shh config' 'Enter: open   Esc: done' top_lines top_act "$art"

    info "saved in $shh_config"
    [ -n "${SHH_INSTALL:-}" ] || info "apply: shh update (before the first install: sh install.sh)"
}

# █  █ █▀▀▄ █▀▀▄ ▄▀▀▄ ▀▀█▀▀ █▀▀▀ 
# █  █ █▀▀  █  █ █▀▀█   █   █▀▀  
#  ▀▀  ▀    ▀▀▀  ▀  ▀   ▀   ▀▀▀▀ 

update() {
    # tmp is not local: the EXIT trap runs after update returns
    local repo

    # installed with --link: update the repo the links point to
    if [ -L "$share/lib.sh" ]; then
        repo=$(cd "$(dirname "$(readlink -f "$share/lib.sh")")/.." && pwd -P)
        step "updating the repo: $repo"
        git -C "$repo" pull --ff-only ||
            error "git pull failed (local changes? see git -C $repo status)"
        # exec: git pull may have replaced this very file
        exec sh "$repo/install.sh"
    fi

    tmp=$(mktemp -d) || error "cannot make a temporary folder"
    trap 'rm -rf "$tmp"' EXIT
    step "downloading $repo_url"
    git clone --depth 1 "$repo_url" "$tmp" || error "git clone failed"
    sh "$tmp/install.sh"
}

# █▀▀▄ ▄▀▀▄ ▄▀▀▀ ▀▀█▀▀ ▄▀▀▄ █▀▀▄ 
# █  █ █  █ █      █   █  █ █▀█  
# ▀▀▀   ▀▀   ▀▀▀   ▀    ▀▀  ▀  ▀ 

problems=0

# bad TEXT: a warning that counts as a problem
bad() {
    warn "$1"
    problems=$((problems + 1))
}

# svc_check (distro.sh): 0 up, 1 down, 2 unknown, 3 can't read the state
check_services() {
    step "services (services.txt)"

    local svc down rc
    # a part turned off in shh config has its service off too
    for svc in $(read_list "$services_file" | without "$(off_items "$components_file" 4)"); do
        rc=0
        down=$(svc_check "$svc") || rc=$?
        case "$rc" in
            0) ok "$svc" ;;
            1) bad "$svc is not running:$down" ;;
            2) bad "$svc: unknown to the init system, run sh install.sh" ;;
            *) bad "cannot read the state of the services"
               return 0 ;;
        esac
    done
}

# every file from the list is there (a broken link counts as missing)
check_files() {
    step "files"

    [ -f "$list" ] || { bad "no $list (sh lib/link.sh)"; return 0; }
    local k dst n=0 found=0
    while IFS="$tab" read -r k dst; do
        n=$((n + 1))
        [ -e "$dst" ] || { bad "missing: $dst (sh lib/link.sh)"; found=1; }
    done <"$list"
    [ "$found" = 1 ] || ok "all $n files in place"
}

# common.csv + system/packages/DRIVER.csv, like install.sh
check_packages() {
    step "packages"

    local hw hardware csv names missing pkg
    hardware=$(sh "$HOME/.local/bin/hardware" 2>/dev/null || true)
    names=$(for hw in common $(gpu_drivers "$hardware"); do
        csv="$packages_dir/$hw.csv"
        [ ! -f "$csv" ] || read_list "$csv" | cut -d, -f2
    done | without "$(off_items "$components_file" 2)")

    # pkg_missing (distro.sh) prints the missing ones
    missing=$(pkg_missing $names)

    for pkg in $missing; do
        bad "not installed: $pkg (sh install.sh)"
    done
    [ -n "$missing" ] || ok "all $(printf '%s\n' "$names" | wc -l) packages installed"
}

# what sway needs without elogind
check_session() {
    step "session"

    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
        ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    else
        bad "XDG_RUNTIME_DIR is not set (PAM sets it at login: sh install.sh)"
    fi

    # id -nG USER: /etc/group; id -nG: this login (needs a relogin to change)
    local user group
    user=$(id -un)
    for group in $(printf %s "$seat_groups" | tr , " "); do
        if ! id -nG "$user" | tr ' ' '\n' | grep -qx "$group"; then
            bad "$user is not in group $group (sh install.sh)"
        elif ! id -nG | tr ' ' '\n' | grep -qx "$group"; then
            bad "group $group: log out and in again"
        else
            ok "group $group"
        fi
    done
}

doctor() {
    [ -f "$distro_file" ] || error "not found: $distro_file (sh lib/link.sh)"
    check_services
    check_files
    check_packages
    check_session

    echo
    [ "$problems" -eq 0 ] || error "$problems problem(s)"
    ok "all good"
}

# ▄▀▀▀ ▄▀▀▄ █    ▄▀▀▄ █▀▀▄ 
# █    █  █ █    █  █ █▀█  
#  ▀▀▀  ▀▀  ▀▀▀▀  ▀▀  ▀  ▀ 

# the palette lives in each program's own config; config/foot/foot.ini lists it.
# Edits the installed files: with --link that is the repo, with copies
# the next update puts the repo colors back (yours stay in .bak files)
color() {
    [ "$#" -eq 2 ] || { usage >&2; exit 1; }
    [ -f "$list" ] || error "no $list (sh lib/link.sh)"

    local old new files c k f
    old=$(printf '%s' "${1#\#}" | tr 'A-F' 'a-f')
    new=$(printf '%s' "${2#\#}" | tr 'A-F' 'a-f')
    for c in "$old" "$new"; do
        printf '%s' "$c" | grep -qx '[0-9a-f]\{6\}' || error "not a color: $c (6 hex digits, like e6e6e6)"
    done

    # configs and scripts; not shh itself (its help has a color in it)
    files=$(while IFS="$tab" read -r k f; do
        case "$f" in "$share"/*|*/shh) continue ;; esac
        printf '%s\n' "$f"
    done <"$list")

    # from now on both are one color: changing it later changes both
    ! printf '%s\n' "$files" | xargs -r -d '\n' grep -qiI -- "$new" || warn "$new is already used too"

    files=$(printf '%s\n' "$files" | xargs -r -d '\n' grep -liI -- "$old" || true)
    [ -n "$files" ] || error "$old is not used in the configs"

    # --follow-symlinks: with --link, edit the repo file, keep the link
    printf '%s\n' "$files" | while IFS= read -r f; do
        sed -i --follow-symlinks "s/$old/$new/gI" "$f"
        ok "$f"
    done
    info "to see it: Super+Shift+C (sway, bar), makoctl reload, new foot and vim / nvim windows"
}

# █▄ ▄█ ▄▀▀▄ ▀█▀ █▄  █ 
# █ ▀ █ █▀▀█  █  █ ▀▄█ 
# ▀   ▀ ▀  ▀ ▀▀▀ ▀   ▀ 

[ "$(id -u)" -ne 0 ] || error "do not run as root, run as your user"

case "${1:-}" in
    config)         config ;;
    update)         update ;;
    doctor)         doctor ;;
    color)          shift; color "$@" ;;
    uninstall)      shift; exec sh "$link_file" --uninstall "$@" ;;
    help|-h|--help) usage ;;
    "")             usage >&2; exit 1 ;;
    *)              usage >&2; error "unknown command: $1" ;;
esac
