#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

#  ▄▄▄ █▄▄  █▄▄  
# ▀▀▄▄ █  █ █  █ 
# ▀▀▀  ▀  ▀ ▀  ▀ 
# shh - look after the dotfiles: pick the parts, update, check, change a color, uninstall
# usage: shh config | update | doctor | color OLD NEW | uninstall [-n] | help

set -eu

# link.sh puts lib.sh, services.txt and packages/ here, so the repo can go
share="$HOME/.local/share/shh"
list="$HOME/.local/state/shh/installed"
repo_url="https://github.com/kiran-why/Shh-dotfiles.git"
tab=$(printf '\t')

# started from the repo (sh scripts/shh config, install.sh): its files, they
# can be newer than $share; ~/.local/bin/shh finds no lib.sh in ~/.local
repo=$(cd "$(dirname "$0")/.." && pwd -P)
[ ! -f "$repo/lib.sh" ] || share="$repo"

[ -f "$share/lib.sh" ] || { echo "lib.sh not found in $share, run sh link.sh from the repo" >&2; exit 1; }
. "$share/lib.sh"

usage() {
    echo "usage: shh COMMAND"
    echo "  config   pick the parts and settings for install.sh (then: shh update)"
    echo "  update   install.sh from a fresh clone (it updates the system and the configs)"
    echo "  doctor   check services, installed files, packages and the session"
    echo "  color OLD NEW  change a color in every config, e.g. shh color d7263d ff0000"
    echo "  uninstall [-n] remove what link.sh put in place, put the old files back (-n: only show)"
    echo "  help     show this help"
}

# ▄▀▀▀ ▄▀▀▄ █▄  █ █▀▀▀ ▀█▀ ▄▀▀▀ 
# █    █  █ █ ▀▄█ █▀▀   █  █ ▀█ 
#  ▀▀▀  ▀▀  ▀   ▀ ▀    ▀▀▀  ▀▀▀ 

# choices for the small menus: "value<TAB>shown text"
modes="copy${tab}copy   copies, the repo can be deleted
link${tab}link   links to the repo, edits land in it"
helpers="yay${tab}yay
paru${tab}paru"
# xkb options for switching the layout
toggles="alt_shift_toggle${tab}Alt+Shift
ctrl_shift_toggle${tab}Ctrl+Shift
win_space_toggle${tab}Super+Space
caps_toggle${tab}Caps Lock
lalt_lshift_toggle${tab}Left Alt+Left Shift"

# copies or links now: link.sh keeps what is installed
if [ -L "$HOME/.local/share/shh/lib.sh" ]; then mode_now=link; else mode_now=copy; fi

# set_value NAME VALUE: change NAME in $shh_config, or add it
set_value() {
    if grep -q "^$1=" "$shh_config"; then
        sed -i "s|^$1=.*|$1=$2|" "$shh_config"
    else
        printf '%s=%s\n' "$1" "$2" >>"$shh_config"
    fi
}

# toggle NAME [DEFAULT]: yes <-> no; DEFAULT when NAME is not set (yes)
toggle() {
    local default="${2:-yes}"
    if [ "$(setting "$1" "$default")" = yes ]; then set_value "$1" no; else set_value "$1" yes; fi
    note="$1: $(setting "$1" "$default")"
}

# lines are "key<TAB>text": only the text shows, the key says what was picked
menu() {
    fzf --info=hidden --delimiter="$tab" --with-nth=2 "$@"
}

# line KEY BOX LABEL TEXT: a menu line
line() {
    printf '%s\t%-3s %-14s %s\n' "$1" "$2" "$3" "$4"
}

# yes_no NAME TEXT [DEFAULT]: a line with [x] or [ ]
yes_no() {
    if [ "$(setting "$1" "${3:-yes}")" = yes ]; then line "$1" '[x]' "$1" "$2"; else line "$1" '[ ]' "$1" "$2"; fi
}

# label_of LIST KEY: the shown text of KEY in LIST
label_of() {
    printf '%s\n' "$1" | awk -F "$tab" -v k="$2" '$1 == k { print $2 }'
}

# choose LABEL LIST: pick one, print its key (nothing on Esc)
choose() {
    printf '%s\n' "$2" | menu --border-label=" $1 " | cut -f1
}

# center TEXT: TEXT in the middle of the menu (window width minus the
# border and the cursor column); with no terminal as it is
center() {
    local cols pad
    cols=$(stty size 2>/dev/null </dev/tty | cut -d" " -f2)
    pad=$(( (${cols:-0} - 4 - ${#1}) / 2 ))
    [ "$pad" -gt 0 ] || pad=0
    printf '%*s%s\n' "$pad" '' "$1"
}

# loop LABEL HEADER LINES ACT: a menu that stays open. LINES prints the
# lines, ACT KEY does the change and may set $note. Esc leaves
loop() {
    local lines pick header pos=1
    note=''
    while :; do
        lines=$("$3")
        # a last line of one space: an empty line above the list
        header=$(center "$2"; [ -z "$note" ] || center "$note"; echo ' ')
        pick=$(printf '%s\n' "$lines" |
            menu --border-label=" $1 " --header="$header" --bind="load:pos($pos)") || return 0
        pos=$(printf '%s\n' "$lines" | grep -nxF -- "$pick" | cut -d: -f1)
        "$4" "${pick%%"$tab"*}"
    done
}

top_lines() {
    line settings '' settings ''
    line features '' features ''
    # an empty line between the two groups; Enter on it does nothing
    printf -- '-\t\n'
    line browser '' browser "$(setting browser firefox)"
    line messengers '' messengers "$(on_list messengers)"
    line vpn '' vpn "$(on_list vpn)"
    line media '' media "$(on_list media)"
    line apps '' apps "$(on_list apps)"
    line tools '' tools "$(on_list tools)"
    line fonts '' fonts "$(on_list fonts)"
}

top_act() {
    local value
    case "$1" in
        settings)
            loop settings 'Enter: change   Esc: back' settings_lines settings_act ;;
        browser)
            value=$(choose browser "$(group browser | awk -F'|' -v t="$tab" '{ printf "%s%s%-10s %s\n", $1, t, $1, $2 }')")
            [ -z "$value" ] || set_value browser "$value" ;;
        features|messengers|vpn|media|apps|tools|fonts)
            # features: the parts with no group
            tab_group=$1
            [ "$1" != features ] || tab_group=''
            loop "$1" 'Enter: on / off   Esc: back' group_lines group_act ;;
    esac
    note=''
}

settings_lines() {
    line mode '' mode "$(setting mode "$mode_now")"
    line layouts '' layouts "$(setting layouts us,ru)"
    line layout_toggle '' 'switch layout' "$(label_of "$toggles" "$(setting layout_toggle alt_shift_toggle)")"
    line aur_helper '' 'aur helper' "$(setting aur_helper yay)"
    yes_no nobeep 'mute the motherboard beeper'
    yes_no pacman 'pacman colors and parallel downloads, AUR builds on all cpu cores'
    yes_no xwayland 'X11 programs; after a relogin' no
}

settings_act() {
    local value
    case "$1" in
        mode)          value=$(choose mode "$modes") ;;
        layout_toggle) value=$(choose 'switch layout' "$toggles") ;;
        aur_helper)    value=$(choose 'aur helper' "$helpers") ;;
        layouts)
            loop layouts 'Enter: on / off   Esc: back   the first one is the default' layout_lines layout_act
            note="layouts: $(setting layouts us,ru)"
            return 0 ;;
        xwayland)
            toggle xwayland no
            return 0 ;;
        *)
            toggle "$1"
            return 0 ;;
    esac
    [ -n "$value" ] || return 0
    set_value "$1" "$value"
    note="$1: $value"
}

# group GROUP: "name|desc|default" of the parts in GROUP (components.txt)
group() {
    read_list "$share/components.txt" | awk -F'|' -v g="$1" '$6 == g { print $1 "|" $5 "|" $7 }'
}

# on_list GROUP: the parts of GROUP turned on, like "btop,man", or none
on_list() {
    local name desc default list
    list=$(group "$1" | while IFS='|' read -r name desc default; do
        [ "$(setting "$name" "${default:-yes}")" = no ] || echo "$name"
    done | paste -sd, -)
    echo "${list:-none}"
}

# the tab of $tab_group: a line per part, Enter turns it on / off
group_lines() {
    local name desc default
    group "$tab_group" | while IFS='|' read -r name desc default; do
        yes_no "$name" "$desc" "${default:-yes}"
    done
}

group_act() {
    toggle "$1" "$(group "$tab_group" | awk -F'|' -v n="$1" '$1 == n { print $3 }')"
}

# every xkb layout as "code<TAB>name"; before the install there is no
# evdev.lst yet (it comes with sway), so a short list
all_layouts() {
    local lst=/usr/share/X11/xkb/rules/evdev.lst
    if [ -f "$lst" ]; then
        awk '/^! layout/ { f = 1; next } /^!/ { f = 0 }
            f && NF { c = $1; $1 = ""; sub(/^ +/, ""); print c "\t" $0 }' "$lst"
        return
    fi
    printf '%s\n' "us${tab}English (US)" "gb${tab}English (UK)" "ru${tab}Russian" \
        "ua${tab}Ukrainian" "by${tab}Belarusian" "kz${tab}Kazakh" "de${tab}German" \
        "fr${tab}French" "es${tab}Spanish" "it${tab}Italian" "pl${tab}Polish" \
        "pt${tab}Portuguese" "tr${tab}Turkish" "cz${tab}Czech"
}

# the layouts turned on first, in their order, then the rest
layout_lines() {
    all_layouts | awk -F "$tab" -v now="$(setting layouts us,ru)" '
        { name[$1] = $2; order[++n] = $1 }
        END {
            k = split(now, on, ",")
            for (i = 1; i <= k; i++) { printf "%s\t[x] %-14s %s\n", on[i], on[i], name[on[i]]; used[on[i]] }
            for (i = 1; i <= n; i++)
                if (!(order[i] in used)) printf "%s\t[ ] %-14s %s\n", order[i], order[i], name[order[i]]
        }'
}

# layout_act CODE: on -> off (one has to stay), off -> on at the end
layout_act() {
    local now
    now=$(setting layouts us,ru)
    case ",$now," in
        *",$1,"*)
            if [ "$now" = "$1" ]; then
                note="one layout has to stay"
                return 0
            fi
            now=$(printf '%s\n' "$now" | tr ',' '\n' | grep -vxF -- "$1" | paste -sd, -) ;;
        *)
            now="$now,$1" ;;
    esac
    set_value layouts "$now"
    note="layouts: $now"
}

# shh config: tabs settings, features, browser, messengers, vpn, media, apps, tools, fonts;
# every change goes to $shh_config at once
config() {
    [ -f "$share/components.txt" ] || error "not found: $share/components.txt (sh link.sh)"
    command -v fzf >/dev/null || sudo pacman -S --needed --noconfirm fzf || error "cannot install fzf"
    # the look of every menu; .zprofile sets it only after the install
    if [ -z "${FZF_DEFAULT_OPTS_FILE:-}" ] && [ -f "$repo/config/fzf/fzfrc" ]; then
        export FZF_DEFAULT_OPTS_FILE="$repo/config/fzf/fzfrc"
    fi

    mkdir -p "${shh_config%/*}"
    [ -f "$shh_config" ] || printf '%s\n' \
        '# ~/.config/shh/config - your choices for install.sh and shh update' \
        '# change: shh config, then shh update (or edit here); a missing line = the default' \
        >"$shh_config"

    loop 'shh config' 'Enter: open   Esc: done' top_lines top_act

    info "saved in $shh_config"
    [ -n "${SHH_INSTALL:-}" ] || info "apply: shh update (before the first install: sh install.sh)"
}

# █  █ █▀▀▄ █▀▀▄ ▄▀▀▄ ▀▀█▀▀ █▀▀▀ 
# █  █ █▀▀  █  █ █▀▀█   █   █▀▀  
#  ▀▀  ▀    ▀▀▀  ▀  ▀   ▀   ▀▀▀▀ 

update() {
    local repo tmp

    # installed with --link: update the repo the links point to
    if [ -L "$share/lib.sh" ]; then
        repo=$(cd "$(dirname "$(readlink -f "$share/lib.sh")")" && pwd -P)
        step "updating the repo: $repo"
        git -C "$repo" pull --ff-only ||
            error "git pull failed (local changes? see git -C $repo status)"
        # exec: git pull may have replaced this very file
        exec sh "$repo/install.sh"
    fi

    tmp=$(mktemp -d) || error "cannot make a temporary folder"
    trap 'rm -rf "$tmp"' EXIT
    step "downloading $repo_url"
    git clone --depth 1 "$repo_url" "$tmp" || error "git clone failed"
    sh "$tmp/install.sh"
}

# █▀▀▄ ▄▀▀▄ ▄▀▀▀ ▀▀█▀▀ ▄▀▀▄ █▀▀▄ 
# █  █ █  █ █      █   █  █ █▀█  
# ▀▀▀   ▀▀   ▀▀▀   ▀    ▀▀  ▀  ▀ 

problems=0

# bad TEXT: a warning that counts as a problem
bad() {
    warn "$1"
    problems=$((problems + 1))
}

# every part of each service must be up (iwd = iwd-srv + iwd-log)
check_services() {
    step "s6 services (services.txt)"

    local active svc parts part down
    active=$(s6-rc -a list 2>/dev/null) || {
        bad "cannot read the s6 state (s6-rc -a list)"
        return 0
    }

    # a part turned off in shh config has its service off too
    for svc in $(read_list "$share/services.txt" | without "$(off_items "$share/components.txt" 4)"); do
        parts=$(s6-rc list "$svc" 2>/dev/null) || {
            bad "$svc: unknown to s6, run sh install.sh"
            continue
        }
        down=""
        for part in $parts; do
            printf '%s\n' "$active" | grep -qxF "$part" || down="$down $part"
        done
        if [ -z "$down" ]; then
            ok "$svc"
        else
            bad "$svc is not running:$down"
        fi
    done
}

# every file from the list is there (a broken link counts as missing)
check_files() {
    step "files"

    [ -f "$list" ] || { bad "no $list (sh link.sh)"; return 0; }
    local k dst n=0 found=0
    while IFS="$tab" read -r k dst; do
        n=$((n + 1))
        [ -e "$dst" ] || { bad "missing: $dst (sh link.sh)"; found=1; }
    done <"$list"
    [ "$found" = 1 ] || ok "all $n files in place"
}

# common.csv + packages/CARD.csv, like install.sh
check_packages() {
    step "packages"

    local hw csv names missing pkg
    names=$(for hw in common $(sh "$HOME/.local/bin/hardware" 2>/dev/null || true); do
        csv="$share/packages/$hw.csv"
        [ ! -f "$csv" ] || read_list "$csv" | cut -d, -f2
    done | without "$(off_items "$share/components.txt" 2)")

    # pacman -T prints the missing ones
    missing=$(pacman -T $names || true)

    for pkg in $missing; do
        bad "not installed: $pkg (sh install.sh)"
    done
    [ -n "$missing" ] || ok "all $(printf '%s\n' "$names" | wc -l) packages installed"
}

# what sway needs without elogind
check_session() {
    step "session"

    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
        ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    else
        bad "XDG_RUNTIME_DIR is not set (pam_rundir in /etc/pam.d/system-login)"
    fi

    # id -nG USER: /etc/group; id -nG: this login (needs a relogin to change)
    local user group
    user=$(id -un)
    for group in seat audio; do
        if ! id -nG "$user" | tr ' ' '\n' | grep -qx "$group"; then
            bad "$user is not in group $group (sh install.sh)"
        elif ! id -nG | tr ' ' '\n' | grep -qx "$group"; then
            bad "group $group: log out and in again"
        else
            ok "group $group"
        fi
    done
}

doctor() {
    check_services
    check_files
    check_packages
    check_session

    echo
    [ "$problems" -eq 0 ] || error "$problems problem(s)"
    ok "all good"
}

# ▄▀▀▀ ▄▀▀▄ █    ▄▀▀▄ █▀▀▄ 
# █    █  █ █    █  █ █▀█  
#  ▀▀▀  ▀▀  ▀▀▀▀  ▀▀  ▀  ▀ 

# the palette lives in each program's own config; config/foot/foot.ini lists it.
# Edits the installed files: with --link that is the repo, with copies
# the next update puts the repo colors back (yours stay in .bak files)
color() {
    [ "$#" -eq 2 ] || { usage >&2; exit 1; }
    [ -f "$list" ] || error "no $list (sh link.sh)"

    local old new files c k f
    old=$(printf '%s' "${1#\#}" | tr 'A-F' 'a-f')
    new=$(printf '%s' "${2#\#}" | tr 'A-F' 'a-f')
    for c in "$old" "$new"; do
        printf '%s' "$c" | grep -qx '[0-9a-f]\{6\}' || error "not a color: $c (6 hex digits, like e6e6e6)"
    done

    # configs and scripts; not shh itself (its help has a color in it)
    files=$(while IFS="$tab" read -r k f; do
        case "$f" in "$share"/*|*/shh) continue ;; esac
        printf '%s\n' "$f"
    done <"$list")

    # from now on both are one color: changing it later changes both
    ! printf '%s\n' "$files" | xargs -r -d '\n' grep -qiI -- "$new" || warn "$new is already used too"

    files=$(printf '%s\n' "$files" | xargs -r -d '\n' grep -liI -- "$old" || true)
    [ -n "$files" ] || error "$old is not used in the configs"

    # --follow-symlinks: with --link, edit the repo file, keep the link
    printf '%s\n' "$files" | while IFS= read -r f; do
        sed -i --follow-symlinks "s/$old/$new/gI" "$f"
        ok "$f"
    done
    info "to see it: Super+Shift+C (sway, bar), makoctl reload, new foot and nvim windows"
}

# █▄ ▄█ ▄▀▀▄ ▀█▀ █▄  █ 
# █ ▀ █ █▀▀█  █  █ ▀▄█ 
# ▀   ▀ ▀  ▀ ▀▀▀ ▀   ▀ 

[ "$(id -u)" -ne 0 ] || error "do not run as root, run as your user"

case "${1:-}" in
    config)         config ;;
    update)         update ;;
    doctor)         doctor ;;
    color)          shift; color "$@" ;;
    uninstall)      shift; exec sh "$share/link.sh" --uninstall "$@" ;;
    help|-h|--help) usage ;;
    "")             usage >&2; exit 1 ;;
    *)              usage >&2; error "unknown command: $1" ;;
esac
