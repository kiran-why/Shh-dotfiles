#!/bin/sh
# ASCII : https://patorjk.com/software/taag/#p=display&f=Linguaholic+Mini+Block&t=SHH-DOTFILES&x=none&v=4&h=4&w=80&we=false

#  ▄▄▄ █▄▄  █▄▄  
# ▀▀▄▄ █  █ █  █ 
# ▀▀▀  ▀  ▀ ▀  ▀ 
# Look after the dotfiles: pick the parts, update, check, change a color,
# uninstall.
#
# Usage: shh config | update [--dry-run] | diff | report | doctor [--config|--graphics|--build|--performance|--network|--audio] | help

set -eu

doctor_usage() {
    echo "usage: shh doctor OPTION"
    printf '  shh doctor %-19s%s\n' \
        '--config'      'check services, installed files, packages and the session' \
        '--graphics'    'show DRM devices, renderer evidence and recent graphics errors' \
        '--audio'        'inspect session audio, local sockets, ALSA and default devices' \
        '--network'     'inspect local interfaces, Wi-Fi, routes and DNS configuration' \
        '--performance' 'sample system resources, desktop processes and Sway startup' \
        '--build'       "check the distro's build/update tools without building"
}

if [ "${1:-}" = doctor ]; then
    case "$#:${2:-}" in
        1:) diagnostic_action=doctor_usage ;;
        2:--config) diagnostic_action=doctor ;;
        2:--graphics|2:--audio|2:--network|2:--performance|2:--build) diagnostic_action=doctor_${2#--} ;;
        *) doctor_usage >&2; exit 2 ;;
    esac
fi

# Report has a small read-only bootstrap, including on a partial installation.
if [ "${1:-}" = report ]; then
    [ "$#" = 1 ] || { echo "usage: shh report" >&2; exit 2; }
    exec 8>&2 2>/dev/null
    export LC_ALL=C
    : "${HOME:=/dev/null}"
fi

# Where link.sh installs lib.sh, link.sh, the lists and packages/, so the
# repo can go.
share="$HOME/.local/share/shh"
list="$HOME/.local/state/shh/installed"
repo_url="https://github.com/kiran-why/Shh-dotfiles.git"
tab=$(printf '\t')

# Read the installed copies, or the files of the repo when started from
# it ('sh scripts/shh config', install.sh): they can be newer.
#
# ~/.local/bin/shh finds no lib/lib.sh in ~/.local, so it is not the repo.
repo=$(cd "$(dirname "$0")/.." && pwd -P)
from_repo=0
if [ -f "$repo/lib/lib.sh" ] && [ "$(cd "$(dirname "$0")" && pwd -P)" = "$repo/scripts" ]; then from_repo=1; fi

if [ "$from_repo" = 1 ]; then lib_file="$repo/lib/lib.sh"; else lib_file="$share/lib.sh"; fi
if [ "${1:-}" = report ]; then
    distro=unknown
else
    [ -f "$lib_file" ] || { echo "lib.sh not found: $lib_file, run sh lib/link.sh from the repo" >&2; exit 1; }
    . "$lib_file"
fi

# The repo has a folder per distro ('$distro': lib.sh), share only this
# one's.
if [ "$from_repo" = 1 ]; then
    link_file="$repo/lib/link.sh"
    components_file="$repo/components/${distro}_components.txt"
    services_file="$repo/system/$distro/services.txt"
    packages_dir="$repo/system/$distro/packages"
    distro_file="$repo/system/$distro/distro.sh"
    recipes_dir="$repo/system/$distro/repo"
else
    link_file="$share/link.sh"
    components_file="$share/components.txt"
    services_file="$share/services.txt"
    packages_dir="$share/packages"
    distro_file="$share/distro.sh"
    recipes_dir="$share/repo"
fi
# scripts/hardware tells what the machine is (the cards).
if [ "$from_repo" = 1 ]; then hardware_script="$repo/scripts/hardware"; else hardware_script="$HOME/.local/bin/hardware"; fi

# Load pkg_*, svc_check and seat_groups. When the file is missing, only
# doctor and the install of fzf need it.
case "${1:-}" in doctor|report) ;; *) [ ! -f "$distro_file" ] || . "$distro_file" ;; esac

usage() {
    echo "usage: shh COMMAND"
    echo
    printf '  %-22s%s\n' \
        'config'           'pick the parts and settings for install.sh (then: shh update)' \
        'update'           'install.sh from a fresh clone (it updates the system and the configs)' \
        'update --dry-run' 'preview this local checkout, without pulling or installing' \
        'diff'             'preview dotfile changes and backups from the local checkout' \
        'report'           'print a diagnostic summary for manual review before sharing' \
        'doctor'           'list diagnostic options' \
        'color OLD NEW'    'change a color in every config, e.g. shh color d7263d ff0000' \
        'uninstall [-n]'   'remove what link.sh put in place, put the old files back (-n: only show)' \
        'help'             'show this help'
}

# ▄▀▀▀ ▄▀▀▄ █▄  █ █▀▀▀ ▀█▀ ▄▀▀▀ 
# █    █  █ █ ▀▄█ █▀▀   █  █ ▀█ 
#  ▀▀▀  ▀▀  ▀   ▀ ▀    ▀▀▀  ▀▀▀ 

# The choices of the small menus, as "value<TAB>shown text".
modes="copy${tab}Copy   copies, the repo can be deleted
link${tab}Link   links to the repo, edits land in it"
# Both have the same look, options and keys (config/vim, config/nvim).
editors="vim${tab}Vim      fewer dependencies
nvim${tab}Neovim"
file_managers="broot${tab}Broot    folders as a tree
yazi${tab}Yazi     previews, tabs"
# The xkb options for switching the layout.
toggles="alt_shift_toggle${tab}Alt+Shift
ctrl_shift_toggle${tab}Ctrl+Shift
win_space_toggle${tab}Super+Space
caps_toggle${tab}Caps Lock
lalt_lshift_toggle${tab}Left Alt+Left Shift"
# DNS servers, comma-separated (install.sh: /etc/resolvconf.conf). Others
# are set by hand in the config.
dns_list="dhcp${tab}DHCP         from the network
1.1.1.1,1.0.0.1${tab}Cloudflare   1.1.1.1
9.9.9.9,149.112.112.112${tab}Quad9        9.9.9.9
8.8.8.8,8.8.4.4${tab}Google       8.8.8.8"

# Copies or links now: link.sh keeps what is installed.
if [ -L "$HOME/.local/share/shh/lib.sh" ]; then mode_now=link; else mode_now=copy; fi

# Change NAME in the config, or add it: set_value NAME VALUE.
set_value() {
    if grep -q "^$1=" "$shh_config"; then
        sed -i "s|^$1=.*|$1=$2|" "$shh_config"
    else
        printf '%s=%s\n' "$1" "$2" >>"$shh_config"
    fi
}

# Switch NAME between yes and no: toggle NAME [DEFAULT].
#
# DEFAULT is the value when NAME is not set (yes).
toggle() {
    local default="${2:-yes}"
    if [ "$(setting "$1" "$default")" = yes ]; then set_value "$1" no; else set_value "$1" yes; fi
    note="$(cap "$1"): $(setting "$1" "$default")"
}

# Show a menu. The lines are "key<TAB>text": only the text shows, the key
# tells what was picked.
menu() {
    fzf --info=hidden --no-input --delimiter="$tab" --with-nth=2 "$@"
}

# Print TEXT with a capital first letter. Menus show it so, the keys stay.
cap() {
    printf '%s%s' "$(printf '%.1s' "$1" | tr '[:lower:]' '[:upper:]')" "${1#?}"
}

# Print a menu line: line KEY BOX LABEL TEXT.
line() {
    printf '%s\t%-3s %-14s %s\n' "$1" "$2" "$(cap "$3")" "$4"
}

# Print a line with [x] or [ ]: yes_no NAME TEXT [DEFAULT].
yes_no() {
    if [ "$(setting "$1" "${3:-yes}")" = yes ]; then line "$1" '[x]' "${4:-$1}" "$2"; else line "$1" '[ ]' "${4:-$1}" "$2"; fi
}

# Print the shown text of KEY in LIST: label_of LIST KEY.
label_of() {
    printf '%s\n' "$1" | awk -F "$tab" -v k="$2" '$1 == k { print $2 }'
}

# Pick one of LIST and print its key (nothing on Esc): choose LABEL LIST.
choose() {
    printf '%s\n' "$2" | menu --border-label=" $(cap "$1") " | cut -f1
}

# Print TEXT in the middle of the menu: center TEXT [WIDTH].
#
# The middle is the window width minus the border and the cursor column.
# With no terminal the text stays as it is. WIDTH is for non-ASCII text:
# dash counts bytes in '${#1}'.
center() {
    local cols pad
    cols=$(stty size 2>/dev/null </dev/tty | cut -d" " -f2)
    pad=$(( (${cols:-0} - 4 - ${2:-${#1}}) / 2 ))
    [ "$pad" -gt 0 ] || pad=0
    printf '%*s%s\n' "$pad" '' "$1"
}

# Show a menu that stays open: loop LABEL HEADER LINES ACT [ART].
#
# LINES prints the lines, 'ACT KEY' does the change and may set '$note'.
# ART goes above HEADER, under an empty line. Esc leaves.
loop() {
    local lines pick header pos=1
    note=''
    while :; do
        lines=$("$3")
        # A last line of one space makes an empty line above the list.
        header=$([ -z "${5:-}" ] || printf ' \n%s\n' "$5"; center "$2"; [ -z "$note" ] || center "$note"; echo ' ')
        pick=$(printf '%s\n' "$lines" |
            menu --border-label=" $(cap "$1") " --header="$header" --bind="load:pos($pos)") || return 0
        pos=$(printf '%s\n' "$lines" | grep -nxF -- "$pick" | cut -d: -f1)
        "$4" "${pick%%"$tab"*}"
    done
}

top_lines() {
    line settings '' settings 'Install options >'
    line features '' features 'Desktop tools >'
    # An empty line between the two groups. Enter on it does nothing.
    printf -- '-\t\n'
    line misc '' misc 'Additional packages >'
    # Only KISS has parts in the recipes group (components.txt).
    [ -z "$(group recipes)" ] || line recipes '' recipes 'KISS recipes >'
}

top_act() {
    case "$1" in
        settings)
            loop settings 'Enter: change   Esc: back' settings_lines settings_act ;;
        features|misc)
            # The features tab holds the parts with no group.
            tab_group=$1
            [ "$1" != features ] || tab_group=''
            loop "$1" 'Enter: on / off   Esc: back' group_lines group_act ;;
        recipes)
            tab_group=recipes
            loop recipes 'Enter: on / off   Esc: back' recipe_lines recipe_act ;;
    esac
    note=''
}

settings_lines() {
    line mode '' mode "$(setting mode "$mode_now") >"
    line layouts '' layouts "$(setting layouts us,ru) >"
    line layout_toggle '' 'switch layout' "$(label_of "$toggles" "$(setting layout_toggle alt_shift_toggle)") >"
    line dns '' dns "$(setting dns dhcp) >"
    line gpu '' graphics "$(setting gpu auto) >"
    line editor '' editor "$(setting editor vim) >"
    line files '' 'file manager' "$(setting files broot) >"
    # distro_settings comes from distro.sh (Artix: aur helper, pacman).
    ! command -v distro_settings >/dev/null || distro_settings
    yes_no nobeep 'Mute the motherboard beeper'
    yes_no maxhz 'Highest refresh rate of every screen'
    if command -v xwayland_hint >/dev/null; then
        yes_no xwayland "$(xwayland_hint)" no
    else
        yes_no xwayland 'X11 programs; after a relogin' no
    fi
    yes_no a11y 'Screen readers in GTK programs; after a relogin' no
}

settings_act() {
    local value
    case "$1" in
        mode)          value=$(choose mode "$modes") ;;
        layout_toggle) value=$(choose 'switch layout' "$toggles") ;;
        dns)           value=$(choose dns "$dns_list") ;;
        editor)        value=$(choose editor "$editors") ;;
        files)         value=$(choose 'file manager' "$file_managers") ;;
        gpu)
            loop graphics "Enter: on / off   Esc: back   found: $(found_cards | sed 's/,/, /g')" gpu_lines gpu_act
            note="Graphics: $(setting gpu auto)"
            return 0 ;;
        layouts)
            loop layouts 'Enter: on / off   Esc: back   the first one is the default' layout_lines layout_act
            note="Layouts: $(setting layouts us,ru)"
            return 0 ;;
        xwayland|a11y)
            toggle "$1" no
            return 0 ;;
        *)
            # distro_act comes from distro.sh (Artix: aur helper). A line that is
            # not its own is a yes / no.
            if ! command -v distro_act >/dev/null || ! value=$(distro_act "$1"); then
                toggle "$1"
                return 0
            fi ;;
    esac
    [ -n "$value" ] || return 0
    set_value "$1" "$value"
    note="$(cap "$1"): $value"
}

# Print "name|default" of the parts in a group (components.txt).
group() {
    read_list "$components_file" | awk -F'|' -v g="$1" '$5 == g { print $1 "|" $6 }'
}

# Print the tab of '$tab_group': a line per part, Enter turns it on / off.
group_lines() {
    local name default
    group "$tab_group" | while IFS='|' read -r name default; do
        case "$name" in
            shh_tools) yes_no "$name" 'System diagnostics and reports' yes 'Shhware Tools' ;;
            *) yes_no "$name" '' "${default:-yes}" ;;
        esac
    done
}

group_act() {
    toggle "$1" "$(group "$tab_group" | awk -F'|' -v n="$1" '$1 == n { print $2 }')"
}

# The KISS recipes tab, laid out like the bar menu's Svc.
#
# On top are the packages of our recipes that the setup can do without
# (bash); off means install.sh does not install them. The last line opens
# every recipe in system/kiss/repo.
recipe_lines() {
    group_lines
    printf -- '-\t\n'
    line all '' 'all recipes' 'Every recipe, even the ones the setup needs >'
    line preview '' preview 'Changes since the last applied selection >'
}

show_recipe_changes() {
    local changes
    changes=$(recipe_preview)
    printf '%s\n' "${changes:-No pending recipe changes.}"
}

recipe_act() {
    case "$1" in
        preview)
            show_recipe_changes | fzf --no-input --header='Local sources only; rebuilds are estimates. Esc: back' >/dev/null || :
            ;;
        all)
            loop 'all recipes' 'Enter: on / off   Esc: back' all_recipe_lines all_recipe_act \
                "$(center 'Off: next source in KISS_PATH, if present; installed package stays')"
            note='' ;;
        # The empty line between the two groups.
        -) ;;
        *) group_act "$1" ;;
    esac
}

# Every recipe of ours with its version.
#
# A recipe that is off (recipe_NAME=no) is not copied for kiss
# (kiss_repos: distro.sh). That counts from the next build of the package:
# what is installed stays as it is.
#
# The versions line up in one column, a tab's width (8 spaces) right of the
# longest name. A real tab can't be used: fzf splits the lines on it.
all_recipe_lines() {
    local dir name box width
    width=$(ls "$recipes_dir" | awk '{ if (length > w) w = length } END { print w + 8 }')
    for dir in "$recipes_dir"/*/; do
        dir=${dir%/} name=${dir##*/}
        box='[x]'
        [ "$(setting "recipe_$name" yes)" = yes ] || box='[ ]'
        printf "%s\t%-3s %-${width}s%s\n" "recipe_$name" "$box" "$(cap "$name")" "$(cut -d' ' -f1 "$dir/version")"
    done
}

all_recipe_act() {
    toggle "$1"
    note="${1#recipe_}: $(setting "$1" yes)"
}

# Print every xkb layout as "code<TAB>name".
#
# Before the install there is no evdev.lst yet (it comes with sway), so
# a short list is used.
all_layouts() {
    local lst=/usr/share/X11/xkb/rules/evdev.lst
    if [ -f "$lst" ]; then
        awk '/^! layout/ { f = 1; next } /^!/ { f = 0 }
            f && NF { c = $1; $1 = ""; sub(/^ +/, ""); print c "\t" $0 }' "$lst"
        return
    fi
    printf '%s\n' "us${tab}English (US)" "gb${tab}English (UK)" "ru${tab}Russian" \
        "ua${tab}Ukrainian" "by${tab}Belarusian" "kz${tab}Kazakh" "de${tab}German" \
        "fr${tab}French" "es${tab}Spanish" "it${tab}Italian" "pl${tab}Polish" \
        "pt${tab}Portuguese" "tr${tab}Turkish" "cz${tab}Czech"
}

# Print the layouts turned on first, in their order, then the rest.
layout_lines() {
    all_layouts | awk -F "$tab" -v now="$(setting layouts us,ru)" '
        { name[$1] = $2; order[++n] = $1 }
        END {
            k = split(now, on, ",")
            for (i = 1; i <= k; i++) { printf "%s\t[x] %-14s %s\n", on[i], on[i], name[on[i]]; used[on[i]] }
            for (i = 1; i <= n; i++)
                if (!(order[i] in used)) printf "%s\t[ ] %-14s %s\n", order[i], order[i], name[order[i]]
        }'
}

# Print the cards scripts/hardware finds, as the choices below
# (amd,nvidia). "nothing" in a VM or with no card.
menu_cards() {
    local cards
    cards=$(sh "$hardware_script" 2>/dev/null) || cards=''
    "$1" "$cards" | sed 's/^nvidia-580xx$/nvidia/' |
        grep -x 'amd\|intel\|nvidia\|nouveau' | sort -u | paste -sd, -
}

found_cards() {
    local cards
    cards=$(menu_cards available_drivers)
    printf '%s\n' "${cards:-nothing}"
}

# Print the graphics menu: auto, or the drivers picked by hand
# (gpu=amd,nvidia; gpu_drivers: lib.sh).
gpu_lines() {
    local now card label text
    now=$(setting gpu auto)
    if [ "$now" = auto ]; then line auto '[x]' auto 'By the card, recommended'
    else line auto '[ ]' auto 'By the card, recommended'; fi
    now=$(menu_cards gpu_drivers)
    for card in amd intel nvidia nouveau; do
        case "$card" in
            amd)     label=AMD;     text='' ;;
            intel)   label=Intel;   text='' ;;
            nvidia)  [ -f "$packages_dir/nvidia.csv" ] || [ -f "$packages_dir/nvidia-580xx.csv" ] || continue
                     label=NVIDIA;  text='The NVIDIA driver' ;;
            nouveau) label=Nouveau; text='The free NVIDIA driver' ;;
        esac
        case ",$now," in
            *",$card,"*) line "$card" '[x]' "$label" "$text" ;;
            *)           line "$card" '[ ]' "$label" "$text" ;;
        esac
    done
}

# Switch to auto, or turn a card on or off, starting from the cards found.
#
# The NVIDIA driver and nouveau can't be on both.
gpu_act() {
    local now
    if [ "$1" = auto ]; then
        set_value gpu auto
        note="Graphics: auto"
        return 0
    fi
    now=$(menu_cards gpu_drivers)
    case ",$now," in
        *",$1,"*) now=$(printf '%s\n' "$now" | tr , '\n' | grep -vxF -- "$1" | paste -sd, -) ;;
        *)
            case "$1" in
                nvidia)  now=$(printf '%s\n' "$now" | tr , '\n' | grep -vx nouveau | paste -sd, -) ;;
                nouveau) now=$(printf '%s\n' "$now" | tr , '\n' | grep -vx nvidia | paste -sd, -) ;;
            esac
            now="${now:+$now,}$1" ;;
    esac
    set_value gpu "${now:-none}"
    note="Graphics: ${now:-none}"
}

# Turn a layout off (one has to stay) or on, at the end of the list.
layout_act() {
    local now
    now=$(setting layouts us,ru)
    case ",$now," in
        *",$1,"*)
            if [ "$now" = "$1" ]; then
                note="One layout has to stay"
                return 0
            fi
            now=$(printf '%s\n' "$now" | tr ',' '\n' | grep -vxF -- "$1" | paste -sd, -) ;;
        *)
            now="$now,$1" ;;
    esac
    set_value layouts "$now"
    note="Layouts: $now"
}

# Show 'shh config': the tabs settings, features, misc (and recipes on
# KISS). Every change goes to the config at once.
config() {
    [ -f "$components_file" ] || error "not found: $components_file (sh lib/link.sh)"
    command -v fzf >/dev/null || pkg_install "" fzf || error "cannot install fzf"
    # The look of every menu. .zprofile sets it only after the install.
    if [ -z "${FZF_DEFAULT_OPTS_FILE:-}" ] && [ -f "$repo/config/fzf/fzfrc" ]; then
        export FZF_DEFAULT_OPTS_FILE="$repo/config/fzf/fzfrc"
    fi

    mkdir -p "${shh_config%/*}"
    if [ ! -f "$shh_config" ]; then
        printf '%s\n' \
            '# ~/.config/shh/config - your choices for install.sh and shh update' \
            '# change: shh config, then shh update (or edit here); a missing line = the default' \
            >"$shh_config"
    fi

    # The font Bloody (patorjk.com), like the fastfetch logo, with N made
    # narrower. 47 columns wide.
    art=$(while IFS= read -r l; do center "$l" 47; done <<'EOF'
 ▄████▄   ▒█████   ███▄  █   █████▒ ██▓  ▄████
▒██▀ ▀█  ▒██▒  ██▒ ██ ▀█ █ ▓██   ▒ ▓██▒ ██▒ ▀█▒
▒▓█    ▄ ▒██░  ██▒▓██  ▀██▒▒████ ░ ▒██▒▒██░▄▄▄░
▒▓▓▄ ▄██▒▒██   ██░▓██▒ ▐██▒░▓█▒  ░ ░██░░▓█  ██▓
▒ ▓███▀ ░░ ████▓▒░▒██░  ██░░▒█░    ░██░░▒▓███▀▒
░ ░▒ ▒  ░░ ▒░▒░▒░ ░ ▒░  ▒ ▒ ▒ ░    ░▓   ░▒   ▒
  ░  ▒     ░ ▒ ▒░ ░ ░░  ░ ▒ ░       ▒ ░  ░   ░
░        ░ ░ ░ ▒     ░  ░ ░ ░ ░     ▒ ░░ ░   ░
░ ░          ░ ░          ░         ░        ░
░
EOF
)
    loop 'shh config' 'Enter: open   Esc: done' top_lines top_act "$art"

    info "saved in $shh_config"
    [ -n "${SHH_INSTALL:-}" ] || info "apply: shh update (before the first install: sh install.sh)"
}

# █  █ █▀▀▄ █▀▀▄ ▄▀▀▄ ▀▀█▀▀ █▀▀▀ 
# █  █ █▀▀  █  █ █▀▀█   █   █▀▀  
#  ▀▀  ▀    ▀▀▀  ▀  ▀   ▀   ▀▀▀▀ 

linked_checkout() {
    local lib root
    lib=$(readlink -f "$share/lib.sh") && [ -f "$lib" ] || error "broken checkout link: $share/lib.sh"
    root=${lib%/lib/lib.sh}
    [ "$root" != "$lib" ] && [ -f "$root/install.sh" ] && [ -f "$root/scripts/shh" ] &&
        [ -f "$root/lib/link.sh" ] || error "invalid linked checkout: $lib"
    printf '%s\n' "$root"
}

update() {
    # 'tmp' is not local: the EXIT trap runs after update returns.
    local repo

    # Installed with '--link': update the repo the links point to.
    if [ -L "$share/lib.sh" ]; then
        repo=$(linked_checkout)
        step "updating the repo: $repo"
        git -C "$repo" pull --ff-only ||
            error "git pull failed (local changes? see git -C $repo status)"
        # 'exec', as 'git pull' may have replaced this very file.
        exec sh "$repo/install.sh"
    fi

    [ "$(setting mode copy)" != link ] ||
        error "link mode requires a persistent checkout; run sh install.sh there"
    tmp=$(mktemp -d) || error "cannot make a temporary folder"
    # An older downloaded installer may allow a mode change in its first-run menu.
    trap 'if [ "$(setting mode copy)" = link ] || [ -L "$share/lib.sh" ]; then
        warn "retained checkout: $tmp"
    else
        rm -rf "$tmp"
    fi' EXIT
    step "downloading $repo_url"
    git clone --depth 1 "$repo_url" "$tmp" || error "git clone failed"
    SHH_TEMP_CHECKOUT=$(cd "$tmp" && pwd -P) sh "$tmp/install.sh"
}

preview() {
    local src="$repo" mode
    info "remote state unknown (no fetch or network access)"
    if [ -L "$share/lib.sh" ]; then
        src=$(linked_checkout)
    elif [ "$from_repo" = 0 ]; then
        src="$HOME/Shh-dotfiles"
    fi
    mode=$(setting mode "$mode_now")
    case "$mode" in copy|link) ;; *) error "unknown install mode: $mode" ;; esac
    if [ "$1" = update ]; then
        if [ "$mode_now" = link ]; then info "apply: git pull --ff-only in $src, then install"
        elif [ "$mode" = link ]; then error "link mode requires a persistent checkout; run sh install.sh there"
        else info "apply: clone $repo_url into a temporary checkout, then install"
        fi
    fi
    [ -f "$src/scripts/shh" ] && [ -f "$src/lib/link.sh" ] ||
        error "no local checkout at $src; run sh scripts/shh $* from your checkout"
    step "local checkout: $src"
    if [ "$mode_now" = link ]; then
        info "linked files share the checkout content; edits through a link have no separate installed copy"
    fi
    if [ "$1" = update ]; then
        [ -r "$src/system/$distro/distro.sh" ] || error "unsupported distro: $distro"
        . "$src/system/$distro/distro.sh"
        packages_dir="$src/system/$distro/packages"
        components_file="$src/components/${distro}_components.txt"
        hardware_script="$src/scripts/hardware"
        recipes_dir="$src/system/$distro/repo"
        [ -f "$shh_config" ] || info "first install: the selection menu may change these defaults"
        info "apply: update the system, install missing selections, configure GPU, network, services and login, then install dotfiles"
        info "packages below use the local installed database; upgrade versions and dependency changes are unknown"
        check_packages preview
        if command -v recipe_preview >/dev/null; then
            step "KISS recipe changes (possible rebuilds only)"
            show_recipe_changes
        fi
    fi
    DOTS_NO_LOGO=1 sh "$src/lib/link.sh" --diff "--$mode"
}

# █▀▀▄ ▄▀▀▄ ▄▀▀▀ ▀▀█▀▀ ▄▀▀▄ █▀▀▄ 
# █  █ █  █ █      █   █  █ █▀█  
# ▀▀▀   ▀▀   ▀▀▀   ▀    ▀▀  ▀  ▀ 

# Check the packages: common.csv and the driver lists, like install.sh.
check_packages() {
    step "packages"

    local hw hardware csv names missing pkg problem=bad
    [ "${1:-}" != preview ] || problem=warn
    for csv in "$packages_dir/common.csv" "$components_file"; do
        if [ ! -f "$csv" ] || [ ! -r "$csv" ]; then
            "$problem" "UNAVAILABLE: cannot check packages without $csv"
            return
        fi
    done
    if [ "$distro" = kiss ]; then
        local db="${KISS_ROOT:-}/${pkg_db:-var/db/kiss/installed}"
        if [ ! -d "$db" ] || [ ! -r "$db" ] || [ ! -x "$db" ]; then
            "$problem" "UNAVAILABLE: installed packages unknown: cannot read $db"
            return
        fi
    fi
    if [ "${1:-}:$distro" != preview:kiss ] && ! command -v "$pkg_query" >/dev/null; then
        "$problem" "UNAVAILABLE: cannot query installed packages: $pkg_query missing"
        return
    fi
    hardware=$(sh "$hardware_script" 2>/dev/null || true)
    names=$(for hw in common $(gpu_drivers "$hardware"); do
        csv="$packages_dir/$hw.csv"
        [ ! -f "$csv" ] || read_list "$csv" | cut -d, -f2
    done | without "$(off_items "$components_file" 2)")

    # pkg_missing (distro.sh) prints the missing ones.
    if [ "$distro" = artix ]; then
        local rc=0
        missing=$(pacman -T $names) || rc=$?
        if [ "$rc" != 0 ] && { [ "$rc" != 127 ] || [ -z "$missing" ]; }; then
            "$problem" "UNAVAILABLE: installed packages unknown: pacman -T failed ($rc)"
            return
        fi
    elif [ "$distro" = void ] && ! xbps-query -l >/dev/null; then
        "$problem" "UNAVAILABLE: installed packages unknown: xbps-query failed"
        return
    else
        missing=$(pkg_missing $names)
    fi

    for pkg in $missing; do
        if [ "${1:-}" = preview ]; then info "would install: $pkg"; else bad "not installed: $pkg (sh install.sh)"; fi
    done
    [ -n "$missing" ] || ok "all $(printf '%s\n' "$names" | awk 'NF { n++ } END { print n+0 }') packages installed"
}

# ▄▀▀▀ ▄▀▀▄ █    ▄▀▀▄ █▀▀▄ 
# █    █  █ █    █  █ █▀█  
#  ▀▀▀  ▀▀  ▀▀▀▀  ▀▀  ▀  ▀ 

# Change a color in every config: color OLD NEW.
#
# The palette lives in each program's own config, config/foot/foot.ini
# lists it. The installed files are edited. With '--link' that is the
# repo, with copies the next update puts the colors of the repo back
# (yours stay in .bak files).
color() {
    [ "$#" -eq 2 ] || { usage >&2; exit 1; }
    [ -f "$list" ] || error "no $list (sh lib/link.sh)"

    local old new files c k f
    old=$(printf '%s' "${1#\#}" | tr 'A-F' 'a-f')
    new=$(printf '%s' "${2#\#}" | tr 'A-F' 'a-f')
    for c in "$old" "$new"; do
        printf '%s' "$c" | grep -qx '[0-9a-f]\{6\}' || error "not a color: $c (6 hex digits, like e6e6e6)"
    done

    # Configs and scripts, but not shh itself: its help has a color in it.
    files=$(while IFS="$tab" read -r k f || [ -n "$k$f" ]; do
        case "$f" in "$share"/*|*/shh) continue ;; esac
        printf '%s\n' "$f"
    done <"$list")

    # From now on both are one color: changing it later changes both.
    #
    # One name per line. 'xargs -0', as busybox has no '-d'.
    ! printf '%s\n' "$files" | tr '\n' '\0' | xargs -r -0 grep -qiI -- "$new" || warn "$new is already used too"

    files=$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -r -0 grep -liI -- "$old" || true)
    [ -n "$files" ] || error "$old is not used in the configs"

    # 'readlink -f': with '--link' edit the repo file and keep the link.
    printf '%s\n' "$files" | while IFS= read -r f; do
        sed -i "s/$old/$new/gI" "$(readlink -f "$f")"
        ok "$f"
    done
    info "to see it: Super+Shift+C (sway, bar), makoctl reload, new foot and vim / nvim windows"
}

# █▄ ▄█ ▄▀▀▄ ▀█▀ █▄  █ 
# █ ▀ █ █▀▀█  █  █ ▀▄█ 
# ▀   ▀ ▀  ▀ ▀▀▀ ▀   ▀ 

# Use fixed messages here: report must never copy a path or config value into output.
tools_error() {
    printf 'Shhware Tools: %s\n' "$1" >&8
    exit 1
}

load_diagnostics() {
    local config="$HOME/.config/shh/config" module="$share/diagnostics.sh" key='' cli sum header
    local dir
    for dir in "$HOME/.config" "$HOME/.config/shh"; do
        if [ -e "$dir" ] || [ -L "$dir" ]; then
            [ -d "$dir" ] && [ -x "$dir" ] || tools_error 'feature configuration unavailable'
        fi
    done
    if [ -e "$config" ] || [ -L "$config" ]; then
        [ -f "$config" ] && [ -r "$config" ] || tools_error 'feature configuration unavailable'
        # Same last-value and comment rules as setting(), without sourcing lib.sh in report.
        key=$(awk '/^shh_tools=/ { sub(/^shh_tools=/,""); sub(/#.*/,""); gsub(/[[:space:]]/,""); v=$0 }
            END {print (v=="" || v=="yes") ? "yes" : "no"}' "$config") ||
            tools_error 'feature configuration unavailable'
        [ "$key" = yes ] || tools_error 'disabled in shh config > Features'
    fi
    if [ "$from_repo" = 1 ]; then
        module="$repo/lib/diagnostics.sh"
        [ ! -L "$module" ] || tools_error 'unexpected checkout module link'
    else
        [ -f "$list" ] && [ ! -L "$list" ] && [ -r "$list" ] &&
            [ "$(cd "${list%/*}" && pwd -P)" = "$(cd "$HOME" && pwd -P)/.local/state/shh" ] ||
            tools_error 'installation manifest unavailable; apply shh update'
        key=$(SHH_MODULE="$module" awk -F '\t' '
            NF!=2 || index($2,ENVIRON["HOME"] "/")!=1 || $2 ~ /(^|\/)[.][.]?(\/|$)|\/\// ||
                !($1 ~ /^\// || (length($1)==64 && $1 ~ /^[a-f0-9]+$/)) { invalid=1 }
            $2==ENVIRON["HOME"] "/.local/state/shh" || index($2,ENVIRON["HOME"] "/.local/state/shh/")==1 ||
                seen[$2]++ { invalid=1 }
            $2==ENVIRON["SHH_MODULE"] { key=$1; count++ }
            END { if (!NR || invalid || count>1) exit 1; print key }' "$list") ||
            tools_error 'damaged installation manifest; apply shh update'
        [ -n "$key" ] || tools_error 'enabled but not installed; apply shh update'
    fi
    [ -f "$module" ] && [ -r "$module" ] || tools_error 'module unavailable; apply shh update'
    # Pin the inode so a concurrent linker rename cannot switch the file after verification.
    exec 7<"$module"
    local pinned=/proc/$$/fd/7
    [ -f "$pinned" ] || tools_error 'cannot open diagnostic module'
    if [ "$from_repo" = 0 ]; then
        case "$key" in
            /*) cli=$(readlink -f "$0") || tools_error 'linked checkout unavailable'
                [ -L "$0" ] &&
                    [ "$cli" = "${cli%/scripts/shh}/scripts/shh" ] &&
                    [ "$key" = "${cli%/scripts/shh}/lib/diagnostics.sh" ] &&
                    [ "$(readlink "$module")" = "$key" ] && [ "$(readlink -f "$module")" = "$key" ] &&
                    [ "$pinned" -ef "$key" ] ||
                    tools_error 'unexpected module link; apply shh update' ;;
            *)  [ ! -L "$module" ] && sum=$(sha256sum <"$pinned") && [ "${sum%% *}" = "$key" ] ||
                    tools_error 'module differs from installed copy; review before updating' ;;
        esac
    fi
    IFS= read -r header <"$pinned" && [ "$header" = '# Shhware diagnostics API 1' ] ||
        tools_error 'incompatible module version; apply shh update'
    . "$pinned"
    exec 7<&-
}

if [ "${1:-}" = report ]; then
    load_diagnostics
    exec 8>&-
    print_report
    exit
fi

[ "$(id -u)" -ne 0 ] || error "do not run as root, run as your user"

case "${1:-}" in
    config)         config ;;
    update)         case "$#:${2:-}" in
                        1:) update ;;
                        2:--dry-run) preview "$@" ;;
                        *) usage >&2; exit 2 ;;
                    esac ;;
    diff)           [ "$#" = 1 ] || { usage >&2; exit 2; }; preview "$@" ;;
    doctor)         load_diagnostics 8>&2
                    [ ! -f "$distro_file" ] || . "$distro_file"
                    "$diagnostic_action" ;;
    color)          shift; color "$@" ;;
    uninstall)      shift; exec sh "$link_file" --uninstall "$@" ;;
    help|-h|--help) usage ;;
    "")             usage >&2; exit 1 ;;
    *)              usage >&2; error "unknown command: $1" ;;
esac
