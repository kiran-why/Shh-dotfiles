#!/bin/sh
# settings - the bar menu's Prefs: Svc, Light (scripts/brightness)
# Svc: our services (services.txt and the vpn) on or off now, All >: every
# service of the init; after a reboot they start as shh config says

set -eu

bin="$HOME/.local/bin"
share="$HOME/.local/share/shh"
. "$share/lib.sh"
. "$share/distro.sh"

menu() {
    fzf --info=hidden --no-input --border=none "$@"
}

# banner NAME: scripts/menu draws it and $MENU_TEXT, again on every resize
banner() {
    printf '%s' "result,resize:transform-header:sh '$bin/menu' --header $1"
}
export MENU_TEXT=
# the last header line: one space, so an empty line sits above the list
gap=$(printf '\n ')

# warning SVC: what breaks when SVC goes off (tty*: s6 names, agetty-*: runit)
warning() {
    case "$1" in
        seatd) echo '! sway needs it' ;;
        dbus)  echo '! wifi, bluetooth need it' ;;
        udevd) echo '! devices, network need it' ;;
        tty*|agetty-*) echo '! ends logins on it' ;;
    esac
}

# "name (state)  warning" for our services (one not installed is left out);
# with "all", every service of the init (svc_list: distro.sh):
# disabled = known, not enabled; boot = a one-time boot step, Enter skips both
service_lines() {
    local all="${1:-}" svc kind rc state
    if [ -n "$all" ]; then svc_list; else read_list "$share/services.txt"; echo "$vpn_svc"; fi |
    while read -r svc kind; do
        rc=0
        if [ "$kind" = boot ]; then rc=boot; else svc_check "$svc" >/dev/null || rc=$?; fi
        case "$rc" in
            0) state=on ;;
            1) state=off ;;
            boot) state=boot ;;
            2) [ -n "$all" ] || continue; state=disabled ;;
            *) continue ;;
        esac
        printf '%-26s %s\n' "$svc ($state)" "$(warning "$svc")"
    done
}

# services [all]: Enter turns the picked one on or off (svc_ctl: distro.sh,
# asks for sudo); our list ends with All >, the same menu for every service
services() {
    local all="${1:-}" list pick svc was armed='' pos=1 note=''
    while :; do
        MENU_TEXT="${note:-Enter: on / off   Esc: back}$gap"
        list=$(service_lines "$all")
        [ -n "$list" ] || list='No services found'
        [ -n "$all" ] || list=$(printf '%s\nAll >' "$list")
        pick=$(printf '%s\n' "$list" |
            menu --bind="$(banner services)" --bind="load:pos($pos)") || return 0
        pos=$(printf '%s\n' "$list" | grep -nxF -- "$pick" | cut -d: -f1)
        svc=${pick%% *}
        was=$armed armed=''
        # a row with a warning is stopped only by the second Enter in a row
        case "$pick:$was" in
            *' (on)'*'!'*":$svc") ;;
            *' (on)'*'!'*) armed=$svc note="Enter again: stop $svc"; continue ;;
        esac
        case "$pick" in
            'All >') note=''; services all ;;
            *' (boot)'*|*' (disabled)'*) note="$svc: cannot be switched here" ;;
            *' (on)'*) svc_ctl stop "$svc" && note="$svc: off" || note="Cannot stop $svc" ;;
            *' (off)'*) svc_ctl start "$svc" && note="$svc: on" || note="Cannot start $svc" ;;
        esac
    done
}

# Light only when scripts/brightness is installed
lines() {
    echo 'Svc >'
    [ ! -x "$bin/brightness" ] || echo 'Light >'
}

pos=1
while :; do
    MENU_TEXT=
    pick=$(lines |
        menu --bind="$(banner settings)" --bind="load:pos($pos)") || exit 0
    case "$pick" in
        'Svc >')   pos=1; services ;;
        # a menu that fails just comes back here
        'Light >') pos=2; "$bin/brightness" || true ;;
    esac
done
