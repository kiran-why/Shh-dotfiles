#!/bin/sh
# Print what we run on, one word per line.
#
# That is the VM type (vmware, virtualbox, qemu, hyperv, xen) or each
# graphics card: amd, intel, nvidia (GTX 16xx, RTX and newer),
# nvidia-580xx (GTX 750 to 10xx), nvidia-legacy. Fails when nothing is
# found. install.sh installs system/DISTRO/packages/WORD.csv.

set -eu

# A PCI slot or firmware device-tree name survives DRM node renumbering.
case "${1:-}" in
    --render-devices|--render-node)
        match=''
        for sys in /sys/class/drm/renderD[0-9]*; do
            node=/dev/dri/${sys##*/}
            [ -c "$node" ] && [ -r "$sys/device/uevent" ] || continue
            id=$(awk -F= '/^PCI_SLOT_NAME=/ {pci=$2} /^OF_FULLNAME=\// {of=$2}
                END {if (pci) print "pci:" pci; else if (of) print "of:" of}' "$sys/device/uevent") || continue
            case "$id" in ''|*[!a-zA-Z0-9_:@.,/-]*) continue ;; esac
            if [ "$1" = --render-devices ]; then
                driver=$(readlink "$sys/device/driver") || driver=GPU
                printf '%s\t%s (%s)\n' "$id" "${driver##*/}" "$id"
            elif [ "$id" = "${2:-}" ]; then
                [ -z "$match" ] && [ -r "$node" ] && [ -w "$node" ] || exit 1
                match=$node
            fi
        done
        if [ "$1" = --render-node ]; then
            [ -n "$match" ] || exit 1
            printf '%s\n' "$match"
        fi
        exit 0 ;;
esac

# Report the kernel's device identities, not the driver chosen in shh config.
if [ "${1:-}" = --graphics ]; then
    for dev in /sys/bus/pci/devices/*; do
        read -r class 2>/dev/null <"$dev/class" || continue
        case "$class" in 0x03*) ;; *) continue ;; esac
        id=$(sed -n 's/^PCI_ID=//p' "$dev/uevent")
        driver=$(readlink "$dev/driver") || driver=unbound
        printf '  PCI %s [%s] driver=%s\n' "${dev##*/}" "$id" "${driver##*/}"
    done
    cards=0 renders=0
    for node in /dev/dri/card[0-9]* /dev/dri/renderD[0-9]*; do
        [ -c "$node" ] || continue
        sys=/sys/class/drm/${node##*/}
        dev=$(readlink -f "$sys/device") || dev=unknown
        driver=$(readlink "$sys/device/driver") || driver=unknown
        r=no w=no
        [ ! -r "$node" ] || r=yes
        [ ! -w "$node" ] || w=yes
        printf '  %s device=%s driver=%s read=%s write=%s\n' "$node" "${dev##*/}" "${driver##*/}" "$r" "$w"
        case "$node" in */card*) cards=$((cards + 1)) ;; *) renders=$((renders + 1)); continue ;; esac
        for connector in "$sys"-*; do
            read -r status 2>/dev/null <"$connector/status" || continue
            [ "$status" = connected ] || continue
            read -r enabled 2>/dev/null <"$connector/enabled" || enabled=unknown
            printf '    %s: connected (%s)\n' "${connector##*/}" "$enabled"
        done
    done
    [ "$renders" -gt 0 ] || echo '  no render node found'
    [ "$cards" -gt 0 ]
    exit
fi

# Test the login workaround only for a modern card actually bound to nouveau.
if [ "${1:-}" = --nouveau-gl ]; then
    for dev in /sys/bus/pci/drivers/nouveau/*:*; do
        [ -r "$dev/device" ] && read -r pci_id <"$dev/device" || continue
        [ "$((pci_id))" -ge "$((0x1e00))" ] || continue
        share="$HOME/.local/share/shh"
        packages_dir="$share/packages"
        . "$share/lib.sh"
        gpu_drivers nvidia | grep -qx nouveau || exit 1
        . "$share/distro.sh"
        command -v nouveau_legacy_gl >/dev/null && nouveau_legacy_gl
        exit $?
    done
    exit 1
fi

dmi=/sys/devices/virtual/dmi/id
id=$(cat "$dmi/sys_vendor" "$dmi/product_name" "$dmi/board_name" 2>/dev/null |
    tr '[:upper:]' '[:lower:]')

case "$id" in
    *vmware*)                         echo vmware;     exit 0 ;;
    *virtualbox*|*innotek*|*oracle*)  echo virtualbox; exit 0 ;;
    *qemu*|*kvm*)                     echo qemu;       exit 0 ;;
    # Hyper-V has the product_name "Virtual Machine" (its sys_vendor is
    # also on real Surface laptops).
    *"virtual machine"*)              echo hyperv;     exit 0 ;;
esac

# Xen does not always show up in DMI.
if [ -r /sys/hypervisor/type ]; then
    cat /sys/hypervisor/type
    exit 0
fi

# Print the NVIDIA driver for a PCI device id (pci.ids: Turing and newer
# from 0x1e00, Maxwell from 0x1340).
nvidia_driver() {
    if [ $(($1)) -ge $((0x1e00)) ]; then
        echo nvidia
    elif [ $(($1)) -ge $((0x1340)) ]; then
        echo nvidia-580xx
    else
        echo nvidia-legacy
    fi
}

# PCI class 0x03 is a display controller.
gpus=$(for dev in /sys/bus/pci/devices/*; do
    case "$(cat "$dev/class" 2>/dev/null)" in
        0x03*) ;;
        *) continue ;;
    esac
    case "$(cat "$dev/vendor")" in
        0x1002) echo amd ;;
        0x8086) echo intel ;;
        0x10de) nvidia_driver "$(cat "$dev/device")" ;;
    esac
done | sort -u)

[ -n "$gpus" ] || exit 1
echo "$gpus"
