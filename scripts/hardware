#!/bin/sh
# Print what we run on, one word per line.
#
# That is the VM type (vmware, virtualbox, qemu, hyperv, xen) or each
# graphics card: amd, intel, nvidia (GTX 16xx, RTX and newer),
# nvidia-580xx (GTX 750 to 10xx), nvidia-legacy. Fails when nothing is
# found. install.sh installs system/DISTRO/packages/WORD.csv.

set -eu

dmi=/sys/devices/virtual/dmi/id
id=$(cat "$dmi/sys_vendor" "$dmi/product_name" "$dmi/board_name" 2>/dev/null |
    tr '[:upper:]' '[:lower:]')

case "$id" in
    *vmware*)                         echo vmware;     exit 0 ;;
    *virtualbox*|*innotek*|*oracle*)  echo virtualbox; exit 0 ;;
    *qemu*|*kvm*)                     echo qemu;       exit 0 ;;
    # Hyper-V has the product_name "Virtual Machine" (its sys_vendor is
    # also on real Surface laptops).
    *"virtual machine"*)              echo hyperv;     exit 0 ;;
esac

# Xen does not always show up in DMI.
if [ -r /sys/hypervisor/type ]; then
    cat /sys/hypervisor/type
    exit 0
fi

# Print the NVIDIA driver for a PCI device id (pci.ids: Turing and newer
# from 0x1e00, Maxwell from 0x1340).
nvidia_driver() {
    if [ $(($1)) -ge $((0x1e00)) ]; then
        echo nvidia
    elif [ $(($1)) -ge $((0x1340)) ]; then
        echo nvidia-580xx
    else
        echo nvidia-legacy
    fi
}

# PCI class 0x03 is a display controller.
gpus=$(for dev in /sys/bus/pci/devices/*; do
    case "$(cat "$dev/class" 2>/dev/null)" in
        0x03*) ;;
        *) continue ;;
    esac
    case "$(cat "$dev/vendor")" in
        0x1002) echo amd ;;
        0x8086) echo intel ;;
        0x10de) nvidia_driver "$(cat "$dev/device")" ;;
    esac
done | sort -u)

[ -n "$gpus" ] || exit 1
echo "$gpus"
