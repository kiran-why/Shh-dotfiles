#!/bin/sh
# vm - prints the VM type (vmware, virtualbox, qemu, xen) and fails on real hardware
# one check for .zprofile (cursor), vmware-clipboard and install.sh

set -eu

dmi=/sys/devices/virtual/dmi/id
id=$(cat "$dmi/sys_vendor" "$dmi/product_name" "$dmi/board_name" 2>/dev/null |
    tr '[:upper:]' '[:lower:]')

case "$id" in
    *vmware*)                         echo vmware ;;
    *virtualbox*|*innotek*|*oracle*)  echo virtualbox ;;
    *qemu*|*kvm*)                     echo qemu ;;
    *)
        # xen does not always show up in DMI
        [ -r /sys/hypervisor/type ] || exit 1
        cat /sys/hypervisor/type ;;
esac
