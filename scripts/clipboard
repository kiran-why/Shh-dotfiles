#!/bin/sh
# clipboard - clipboard history (cliphist): pick an old copy to copy it again
# $mod+c. Enter copies, Ctrl+D deletes one, the first line clears all.
# the history size is in ~/.config/cliphist/config
# clipboard open: what the key runs (the window, or closes it)

set -eu

# clipboard open (the key): close its window if it is open, else open it.
# kill fails (exit 2) when no window matches
if [ "${1:-}" = open ]; then
    swaymsg '[app_id="clipboard"] kill' >/dev/null 2>&1 && exit 0
    exec footclient --app-id=clipboard "$0"
fi

# the last header line: one space, so an empty line sits above the list
gap=$(printf '\n ')

# cliphist lines are "id<TAB>preview", newest first; --expect prints the key first
menu() {
    fzf --border-label=' Clipboard ' --header="Enter: copy   Ctrl-D: delete$gap" \
        --no-sort --delimiter='\t' --with-nth=2.. --expect=ctrl-d
}

# empty id, so it can't be a cliphist line
clear_all='	Clear history'

while :; do
    out=$({ printf '%s\n' "$clear_all"; cliphist list; } | menu) || exit 0
    key=$(printf '%s\n' "$out" | head -n 1)
    pick=$(printf '%s\n' "$out" | sed -n 2p)

    if [ "$pick" = "$clear_all" ]; then
        if [ "$key" = ctrl-d ]; then continue; fi
        cliphist wipe
        ~/.local/bin/notify -a clipboard 'clipboard history cleared' || true
        exit 0
    fi

    if [ "$key" = ctrl-d ]; then
        printf '%s\n' "$pick" | cliphist delete
        continue
    fi

    printf '%s\n' "$pick" | cliphist decode | wl-copy
    exit 0
done
