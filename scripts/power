#!/bin/sh
# Exit sway, power off, reboot or sleep ($mod+L, the bar menu). A pick
# runs at once, with no "are you sure".
#
# 'power poweroff | reboot | suspend' shows no menu (a terminal, Sleep).

set -eu

bin="$HOME/.local/bin"

menu() {
    fzf --info=hidden --no-input --border=none "$@"
}

# The banner. scripts/menu draws it, again on every resize.
banner="result,resize:transform-header:sh '$bin/menu' --header power"
export MENU_TEXT=

# Run power_run (distro.sh) as root. The sudoers rule comes from
# install.sh.
run() {
    . "$HOME/.local/share/shh/distro.sh"
    power_run "$1" ||
        ~/.local/bin/notify -a power -u critical power "$1 failed: no sudo rule? run shh update" || true
}

# Lock first: 'swaylock -f' returns once the screen is locked.
suspend_now() {
    pgrep -x swaylock >/dev/null || swaylock -f
    run suspend
    # Awake again: scripts/lock may have turned the screens off.
    swaymsg 'output * power on' >/dev/null
    # The sleep of the bar doesn't count the time asleep, so redraw the
    # clock now.
    kill -USR1 "$(cat "${XDG_RUNTIME_DIR:-/tmp}/shh-bar.pid" 2>/dev/null)" 2>/dev/null || true
}

case "${1:-}" in
    poweroff|reboot) run "$1"; exit 0 ;;
    suspend)         suspend_now; exit 0 ;;
esac

pick=$(printf '%s\n' 'Exit' 'Power off' 'Reboot' 'Sleep' |
    menu --bind="$banner") || exit 0
case "$pick" in
    'Exit')      swaymsg exit >/dev/null ;;
    'Power off') run poweroff ;;
    'Reboot')    run reboot ;;
    # Outside this window: it closes now, not after the wake-up.
    'Sleep')     swaymsg exec "$bin/power suspend" >/dev/null ;;
esac
