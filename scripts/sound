#!/bin/sh
# sound - start PipeWire with sway and stop it when sway exits
# (no systemd to do it for us)

set -eu

# leftovers from a crashed session would block the new pipewire
for prog in pipewire-pulse wireplumber pipewire; do
    pkill -u "$(id -u)" -x "$prog" || true
done

pipewire &
pipewire_pid=$!

# wait up to 5 s for the socket; errors land in ~/.local/state/shh/wm.log
socket="$XDG_RUNTIME_DIR/pipewire-0"
tries=0
until [ -S "$socket" ]; do
    tries=$((tries + 1))
    if [ "$tries" -gt 25 ]; then
        echo "sound: pipewire did not start, no $socket" >&2
        exit 1
    fi
    sleep 0.2
done

wireplumber &
wireplumber_pid=$!
pipewire-pulse &
pulse_pid=$!

# blocks until sway exits
swaymsg -t subscribe '["shutdown"]' >/dev/null 2>&1 || true
kill "$pulse_pid" "$wireplumber_pid" "$pipewire_pid" 2>/dev/null || true
