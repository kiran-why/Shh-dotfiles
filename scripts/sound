#!/bin/sh
# Start PipeWire with sway and stop it when sway exits (there is no
# systemd to do it for us).

set -eu

case "${XDG_RUNTIME_DIR:-}" in
    /*) [ -d "$XDG_RUNTIME_DIR" ] && [ -x "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ] ||
        { echo 'sound: runtime directory unavailable' >&2; exit 1; } ;;
    *) echo 'sound: XDG_RUNTIME_DIR must be absolute' >&2; exit 1 ;;
esac

for prog in pipewire wireplumber pipewire-pulse swaymsg; do
    command -v "$prog" >/dev/null || { echo "sound: $prog: not found" >&2; exit 1; }
done

# Leftovers from a crashed session would block the new pipewire.
for prog in pipewire-pulse wireplumber pipewire; do
    # No '-u': busybox pkill lacks it, and a user signals only their own
    # processes anyway.
    pkill -x "$prog" || true
done

pipewire_pid= wireplumber_pid= pulse_pid= swaymsg_pid=
cleanup() {
    for pid in "$swaymsg_pid" "$pulse_pid" "$wireplumber_pid" "$pipewire_pid"; do
        [ -n "$pid" ] && stat=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
        # A daemon may have exited and its PID been reused during the session.
        case "${stat##*) }" in ?\ "$$"\ *) kill "$pid" 2>/dev/null || : ;; esac
    done
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
pipewire &
pipewire_pid=$!

# Wait up to 5 s for the socket. Errors land in ~/.local/state/shh/wm.log.
socket="$XDG_RUNTIME_DIR/pipewire-0"
tries=0
until [ -S "$socket" ]; do
    tries=$((tries + 1))
    if [ "$tries" -gt 25 ]; then
        echo "sound: pipewire did not start, no $socket" >&2
        exit 1
    fi
    sleep 0.2
done

wireplumber &
wireplumber_pid=$!
pipewire-pulse &
pulse_pid=$!

# Blocks until sway exits.
swaymsg -t subscribe '["shutdown"]' >/dev/null 2>&1 &
swaymsg_pid=$!
wait "$swaymsg_pid" || :
swaymsg_pid=''
