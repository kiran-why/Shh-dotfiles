#!/bin/sh
# sound - start PipeWire for this sway session
#
# there is no systemd (and no s6 user services here), so nobody starts
# PipeWire for us. sway runs this once at login (exec in sway/programs):
#   pipewire        the sound server itself
#   wireplumber     the session manager: finds the sound card, picks the
#                   default output; without it pipewire plays nothing
#   pipewire-pulse  speaks the PulseAudio protocol (firefox, ncpamixer)
# all three need the session D-Bus: ~/.zprofile starts sway inside
# dbus-run-session. They connect to each other through a socket
# in $XDG_RUNTIME_DIR.
# the script keeps running until sway exits and then stops all three:
# they don't need wayland, so on their own they would keep running

set -eu

# copies left over from a session that did not end cleanly (sway
# crashed) would hold the socket, and a second pipewire would fail.
# pkill -u UID: only our own processes; -x: the exact name, so
# "pipewire" does not also match "pipewire-pulse".
# "|| true": pkill fails when there is nothing to stop, that is fine
for prog in pipewire-pulse wireplumber pipewire; do
    pkill -u "$(id -u)" -x "$prog" || true
done

# & runs it in the background, the script goes on;
# $! is the pid of what was just started, kept to stop it later
pipewire &
pipewire_pid=$!

# wireplumber and pipewire-pulse fail if pipewire is not ready yet.
# wait until its socket exists ([ -S FILE ]: FILE is a socket),
# checking every 0.2 s, 25 times = 5 s at most
socket="$XDG_RUNTIME_DIR/pipewire-0"
tries=0
until [ -S "$socket" ]; do
    tries=$((tries + 1))
    if [ "$tries" -gt 25 ]; then
        # sway writes our output to its log (~/.local/state/shh/wm.log)
        echo "sound: pipewire did not start, no $socket" >&2
        exit 1
    fi
    sleep 0.2
done

wireplumber &
wireplumber_pid=$!
pipewire-pulse &
pulse_pid=$!

# wait for sway to exit: swaymsg subscribes to the "shutdown" event
# (man 7 sway-ipc) and, without -m, exits after the first one. If sway
# crashes instead, the connection breaks and swaymsg exits too ("|| true")
swaymsg -t subscribe '["shutdown"]' >/dev/null 2>&1 || true
kill "$pulse_pid" "$wireplumber_pid" "$pipewire_pid" 2>/dev/null || true
