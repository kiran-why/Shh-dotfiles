#!/bin/sh
# wifi - pick a network and connect (iwd asks for the password itself)
# opened from the wifi icon in swaybar

set -eu

menu() {
    fzf --info=hidden "$@"
}

# iwctl colors its output
plain() {
    sed 's/\x1b\[[0-9;]*m//g'
}

devices=$(for d in /sys/class/net/*; do
    if [ -d "$d/wireless" ]; then echo "${d##*/}"; fi
done)
if [ -z "$devices" ]; then
    echo 'no wifi device found'
    sleep 3
    exit 1
fi
# more than one (a usb wifi stick): ask which
if [ "$(echo "$devices" | wc -l)" -gt 1 ]; then
    dev=$(echo "$devices" | menu --border-label=' device ') || exit 0
else
    dev=$devices
fi

# the network we are connected to
current() {
    iwctl station "$dev" show | plain |
        sed -n 's/^ *Connected network  *\(.*[^ ]\) *$/\1/p'
}

# network names: without the table header, the ">" mark and the
# security and signal columns
networks() {
    iwctl station "$dev" get-networks | plain |
        grep -v -e '---' -e 'Available networks' -e 'Network name' |
        sed -E 's/^[ >]*//; s/ +[a-z0-9-]+ +\** *$//' |
        grep -v '^ *$'
}

iwctl station "$dev" scan 2>/dev/null || true
sleep 2

while :; do
    pick=$({ echo rescan; echo disconnect; networks; } |
        menu --border-label=' wifi ' --header="$dev: $(current || true)") || exit 0
    case "$pick" in
        rescan)
            iwctl station "$dev" scan || true
            sleep 2
            ;;
        disconnect)
            iwctl station "$dev" disconnect || true
            ;;
        *)
            if iwctl station "$dev" connect "$pick"; then
                notify-send -a wifi 'wifi connected' "$pick" || true
                exit 0
            fi
            notify-send -a wifi 'wifi: could not connect' "$pick" || true
            echo 'could not connect, press Enter'
            read -r _
            ;;
    esac
done
