#!/bin/sh
# The wifi menu: available networks (connect), known networks (forget),
# check the internet, disconnect. Opened from the bar menu (scripts/menu).

set -eu

menu() {
    fzf --info=hidden --no-input --border=none "$@"
}

# The last header line is one space, so an empty line sits above the list.
gap=$(printf '\n ')

# The banner of the main menu. scripts/menu draws it and '$MENU_TEXT'
# under it in the middle, again on every resize.
banner="result,resize:transform-header:sh '$HOME/.local/bin/menu' --header wifi"
export MENU_TEXT=

# Strip the colors iwctl puts on its output.
plain() {
    sed 's/\x1b\[[0-9;]*m//g'
}

devices=$(for d in /sys/class/net/*; do
    if [ -d "$d/wireless" ]; then echo "${d##*/}"; fi
done)
if [ -z "$devices" ]; then
    echo 'no wifi device found'
    sleep 3
    exit 1
fi
# More than one device (a usb wifi stick): ask which.
if [ "$(echo "$devices" | wc -l)" -gt 1 ]; then
    dev=$(echo "$devices" | menu) || exit 0
else
    dev=$devices
fi

# Print the network we are connected to.
current() {
    iwctl station "$dev" show | plain |
        sed -n 's/^ *Connected network  *\(.*[^ ]\) *$/\1/p'
}

# Print the available networks as "name<TAB>bars  security  name".
#
# The columns are cut by the header, so names with spaces work. The
# signal is 4 stars, the weak part gray.
networks() {
    iwctl station "$dev" get-networks | awk '
        BEGIN { split("▂ ▄ ▆ █", bar, " ") }
        { p = $0; gsub(/\033\[[0-9;]*m/, "", p) }
        p ~ /Network name/ { sec = index(p, "Security"); sig = index(p, "Signal"); next }
        !sec || p ~ /^-+$/ || p ~ /^ *$/ { next }
        {
            name = substr(p, 1, sec - 1); now = (name ~ />/)
            sub(/^[ >]+/, "", name); sub(/ +$/, "", name)
            security = substr(p, sec, sig - sec); gsub(/ /, "", security)
            stars = substr(p, sig); total = gsub(/\*/, "", stars)
            gray = 0
            if (match($0, /\033\[1;90m\*+/)) { g = substr($0, RSTART, RLENGTH); gray = gsub(/\*/, "", g) }
            # A bar per bright star. No substr: it cuts UTF-8 by bytes.
            bars = ""
            for (i = 1; i <= 4; i++) bars = bars (i <= total - gray ? bar[i] : " ")
            printf "%s\t%s  %-6s %s%s\n", name, bars, security, name, (now ? "  (now)" : "")
        }'
}

# Print the saved networks, one name per line (the column "Name" up to
# "Security").
known() {
    iwctl known-networks list | awk '
        { p = $0; gsub(/\033\[[0-9;]*m/, "", p) }
        p ~ /^ *Name / { sec = index(p, "Security"); next }
        !sec || p ~ /^-+$/ || p ~ /^ *$/ { next }
        { name = substr(p, 1, sec - 1); sub(/^ +/, "", name); sub(/ +$/, "", name); print name }'
}

scan() {
    iwctl station "$dev" scan 2>/dev/null || true
    sleep 2
}

# Pick a network and connect. iwd asks for the password itself. Esc goes
# back.
available_menu() {
    local pick
    scan
    while :; do
        pick=$({ printf 'rescan\tRescan\n'; networks; } |
            menu --header="$dev: $(current || true)$gap" \
                --delimiter='\t' --with-nth=2 | cut -f1) || return 0
        case "$pick" in
            '')     return 0 ;;
            rescan) scan ;;
            *)
                if iwctl station "$dev" connect "$pick"; then
                    ~/.local/bin/notify -a wifi 'wifi connected' "$pick" || true
                    exit 0
                fi
                ~/.local/bin/notify -a wifi 'wifi: could not connect' "$pick" || true
                echo 'could not connect, press Enter'
                read -r _
                ;;
        esac
    done
}

# Forget a saved network (its password too). Esc goes back.
known_menu() {
    local pick
    while :; do
        pick=$(known | menu --header="Enter: forget$gap") || return 0
        iwctl known-networks "$pick" forget || true
        ~/.local/bin/notify -a wifi 'wifi: forgot' "$pick" || true
    done
}

# Check the internet. https, not ping: ICMP is often blocked. A few
# sites, as one can be down.
check_internet() {
    local site
    for site in https://github.com https://kernel.org https://wikipedia.org; do
        if curl -s -o /dev/null -m 5 "$site"; then
            note='Internet: ok'
            return
        fi
    done
    note='Internet: no connection'
}

# 'pos' keeps the cursor on the last picked line, 'note' the last check.
pos=1
note=''
while :; do
    MENU_TEXT="$dev: $(current || true)${note:+
$note}$gap"
    pick=$(printf '%s\n' 'Available networks >' 'Known networks >' 'Check internet' 'Disconnect' |
        menu --bind="$banner" --bind="load:pos($pos)") || exit 0
    note=''
    case "$pick" in
        'Available networks >') pos=1; available_menu ;;
        'Known networks >')     pos=2; known_menu ;;
        'Check internet')       pos=3; check_internet ;;
        Disconnect)           pos=4; iwctl station "$dev" disconnect || true ;;
    esac
done
