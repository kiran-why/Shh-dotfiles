#!/bin/sh
# Manage wifi from the bar menu. KISS uses eiwd profiles; Artix and Void
# use iwctl to scan, connect and forget networks.

set -eu

menu() {
    fzf --info=hidden --no-input --border=none "$@"
}

# The last header line is one space, so an empty line sits above the list.
gap=$(printf '\n ')

# The banner of the main menu. scripts/menu draws it and '$MENU_TEXT'
# under it in the middle, again on every resize.
banner="result,resize:transform-header:sh '$HOME/.local/bin/menu' --header wifi"
export MENU_TEXT=

# Strip the colors iwctl puts on its output.
plain() {
    sed 's/\x1b\[[0-9;]*m//g'
}

# Print the network we are connected to.
current() {
    iwctl station "$dev" show | plain |
        sed -n 's/^ *Connected network  *\(.*[^ ]\) *$/\1/p'
}

# Print the available networks as "name<TAB>bars  security  name".
#
# The columns are cut by the header, so names with spaces work. The
# signal is 4 stars, the weak part gray.
networks() {
    iwctl station "$dev" get-networks | awk '
        BEGIN { split("▂ ▄ ▆ █", bar, " ") }
        { p = $0; gsub(/\033\[[0-9;]*m/, "", p) }
        p ~ /Network name/ { sec = index(p, "Security"); sig = index(p, "Signal"); next }
        !sec || p ~ /^-+$/ || p ~ /^ *$/ { next }
        {
            name = substr(p, 1, sec - 1); now = (name ~ />/)
            sub(/^[ >]+/, "", name); sub(/ +$/, "", name)
            security = substr(p, sec, sig - sec); gsub(/ /, "", security)
            stars = substr(p, sig); total = gsub(/\*/, "", stars)
            gray = 0
            if (match($0, /\033\[1;90m\*+/)) { g = substr($0, RSTART, RLENGTH); gray = gsub(/\*/, "", g) }
            # A bar per bright star. No substr: it cuts UTF-8 by bytes.
            bars = ""
            for (i = 1; i <= 4; i++) bars = bars (i <= total - gray ? bar[i] : " ")
            printf "%s\t%s  %-6s %s%s\n", name, bars, security, name, (now ? "  (now)" : "")
        }'
}

# Print the saved networks, one name per line (the column "Name" up to
# "Security").
known() {
    iwctl known-networks list | awk '
        { p = $0; gsub(/\033\[[0-9;]*m/, "", p) }
        p ~ /^ *Name / { sec = index(p, "Security"); next }
        !sec || p ~ /^-+$/ || p ~ /^ *$/ { next }
        { name = substr(p, 1, sec - 1); sub(/^ +/, "", name); sub(/ +$/, "", name); print name }'
}

scan() {
    iwctl station "$dev" scan 2>/dev/null || true
    sleep 2
}

# Pick a network and connect. iwd asks for the password itself. Esc goes
# back.
available_menu() {
    local pick
    scan
    while :; do
        pick=$({ printf 'rescan\tRescan\n'; networks; } |
            menu --header="$dev: $(current || true)$gap" \
                --delimiter='\t' --with-nth=2 | cut -f1) || return 0
        case "$pick" in
            '')     return 0 ;;
            rescan) scan ;;
            *)
                if iwctl station "$dev" connect "$pick"; then
                    ~/.local/bin/notify -a wifi 'wifi connected' "$pick" || true
                    exit 0
                fi
                ~/.local/bin/notify -a wifi 'wifi: could not connect' "$pick" || true
                echo 'could not connect, press Enter'
                read -r _
                ;;
        esac
    done
}

# Forget a saved network (its password too). Esc goes back.
known_menu() {
    local pick
    while :; do
        pick=$(known | menu --header="Enter: forget$gap") || return 0
        iwctl known-networks "$pick" forget || true
        ~/.local/bin/notify -a wifi 'wifi: forgot' "$pick" || true
    done
}

# Check the internet. https, not ping: ICMP is often blocked. A few
# sites, as one can be down.
check_internet() {
    local site
    for site in https://github.com https://kernel.org https://wikipedia.org; do
        if curl -s -o /dev/null -m 5 "$site"; then
            note='Internet: ok'
            return
        fi
    done
    note='Internet: no connection'
}

# Read a passphrase without echoing it. Restore the terminal even on Ctrl+C.
eiwd_password() (
    tty_mode=$(stty -g) || exit 1
    trap 'stty "$tty_mode"; printf "\n" >&2' EXIT
    trap 'exit 1' HUP INT TERM
    stty -echo || exit 1
    printf 'Passphrase: ' >&2
    IFS= read -r pass && printf '%s' "$pass"
)

# Add a profile for autoconnect. eiwd watches the directory for new files.
eiwd_add() {
    local ssid name type pass size data
    printf 'Network name: '
    IFS= read -r ssid && [ -n "$ssid" ] || return 0
    if [ "$(printf %s "$ssid" | wc -c)" -gt 32 ]; then
        note='Network names are at most 32 bytes'
        return
    fi
    type=$(printf '%s\n' 'Personal (password)' 'Open' |
        menu --header="Security$gap") || return 0
    # Match the filename encoding in 'iwd.network(5)'.
    case "$ssid" in
        *[!a-zA-Z0-9_' '-]*) name="=$(printf %s "$ssid" | od -An -tx1 -v | tr -d ' \n')" ;;
        *) name=$ssid ;;
    esac
    case "$type" in
        Open) name=$name.open; data='[Settings]' ;;
        *)
            name=$name.psk
            pass=$(eiwd_password) && [ -n "$pass" ] || return 0
            size=$(printf %s "$pass" | wc -c)
            if [ "$size" -lt 8 ] || [ "$size" -gt 63 ]; then
                note='Use a passphrase of 8 to 63 bytes'
                return
            fi
            # Escape spaces and backslashes for the eiwd settings reader.
            data=$(printf '%s\n' "$pass" | sed 's/\\/\\\\/g; s/ /\\s/g' |
                iwd_passphrase "$ssid" 2>/dev/null) || { note='Could not make profile'; return; }
            ;;
    esac
    # Publish a complete, private profile. 'ln' refuses to replace an old one.
    if printf '%s\n' "$data" | sudo sh -ec '
        umask 077
        tmp=$(mktemp "$1/.shh-XXXXXX")
        trap '\''rm -f "$tmp"'\'' EXIT
        cat > "$tmp"
        ln "$tmp" "$1/$2"
    ' sh "$profiles" "$name"; then
        note='Profile saved for autoconnect'
    else
        note='Not saved (existing profile or write failed)'
    fi
}

eiwd_known() {
    local names file
    # Only filenames leave the root-owned directory, never the credentials.
    names=$(sudo find "$profiles" -maxdepth 1 -type f \
        \( -name '*.psk' -o -name '*.open' -o -name '*.8021x' \)) ||
        { note='Could not list profiles'; return; }
    [ -n "$names" ] || { note='No saved networks'; return; }
    file=$(printf '%s\n' "$names" | sed 's|.*/||' | sort |
        menu --header="Enter: forget profile$gap") || return 0
    case "$file" in
        */*) return 1 ;;
        *.psk|*.open|*.8021x)
            if sudo rm "$profiles/$file"; then note='Profile forgotten'; else note='Could not forget profile'; fi ;;
    esac
}

# Keep the service switch available even when eiwd has removed its interface.
eiwd_menu() {
    local profiles=/var/lib/iwd state action cmd
    while :; do
        state=$(fastfetch -s Wifi --format json | jq -r '
            .[] | .result[]? | "\(.inf.description): \(.conn.ssid | if . == "" or . == null then "disconnected" else . end)"') || state=''
        if svc_check eiwd >/dev/null; then action='Stop Wifi'; cmd=stop
        else action='Start Wifi'; cmd=start; state='Wifi is off'; fi
        MENU_TEXT="${state:-No wifi device}${note:+
$note}$gap"
        pick=$(printf '%s\n' 'Add network >' 'Known networks >' 'Check internet' "$action" |
            menu --bind="$banner" --bind="load:pos($pos)") || return 0
        note=''
        case "$pick" in
            'Add network >')    pos=1; eiwd_add ;;
            'Known networks >') pos=2; eiwd_known ;;
            'Check internet')   pos=3; check_internet ;;
            "$action")          pos=4; svc_ctl "$cmd" eiwd || note='Could not change wifi state' ;;
        esac
    done
}

# 'pos' keeps the cursor on the last picked line, 'note' the last check.
pos=1
note=''
. "$HOME/.local/share/shh/lib.sh"
if [ "$distro" = kiss ]; then
    . "$HOME/.local/share/shh/distro.sh"
    eiwd_menu
    exit 0
fi

devices=$(for d in /sys/class/net/*; do
    if [ -d "$d/wireless" ]; then echo "${d##*/}"; fi
done)
if [ -z "$devices" ]; then
    echo 'no wifi device found'
    sleep 3
    exit 1
fi
# More than one device (a usb wifi stick): ask which.
if [ "$(echo "$devices" | wc -l)" -gt 1 ]; then
    dev=$(echo "$devices" | menu) || exit 0
else
    dev=$devices
fi

while :; do
    MENU_TEXT="$dev: $(current || true)${note:+
$note}$gap"
    pick=$(printf '%s\n' 'Available networks >' 'Known networks >' 'Check internet' 'Disconnect' |
        menu --bind="$banner" --bind="load:pos($pos)") || exit 0
    note=''
    case "$pick" in
        'Available networks >') pos=1; available_menu ;;
        'Known networks >')     pos=2; known_menu ;;
        'Check internet')       pos=3; check_internet ;;
        Disconnect)           pos=4; iwctl station "$dev" disconnect || true ;;
    esac
done
