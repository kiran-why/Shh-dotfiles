#!/bin/sh
# The sound menu: volume up / down, mute, input and output devices.
# Opened from the bar menu (scripts/menu).
#
# 'volume up | down | mute' shows no menu: it is for the volume keys and
# shows the level.

set -eu

out=@DEFAULT_AUDIO_SINK@
mic=@DEFAULT_AUDIO_SOURCE@
# The step and the max (1.0 is 100%).
step=5%
max=1.0

menu() {
    fzf --info=hidden --no-input --border=none "$@"
}

# The last header line is one space, so an empty line sits above the list.
gap=$(printf '\n ')

# The banner of the main menu. scripts/menu draws it and '$MENU_TEXT'
# under it in the middle, again on every resize.
banner="result,resize:transform-header:sh '$HOME/.local/bin/menu' --header volume"
export MENU_TEXT=

# Hide the harmless "RTKit error" lines of wpctl, which would mess up
# the menu.
wp() {
    wpctl "$@" 2>/dev/null
}

# Print a level as a bar: line PERCENT.
line() {
    local full=$((($1 + 5) / 10)) i=0 text=''
    [ "$full" -gt 10 ] && full=10
    while [ "$i" -lt 10 ]; do
        if [ "$i" -lt "$full" ]; then text="$text━"; else text="$text─"; fi
        i=$((i + 1))
    done
    printf '%s' "$text"
}

# Print the device name people see.
name() {
    wp inspect "$1" | sed -n 's/.*node\.description = "\(.*\)"/\1/p' | head -n 1
}

# Print the id behind @DEFAULT_AUDIO_SINK@ or SOURCE@ ("id 45, type ...").
default_id() {
    wp inspect "$1" | sed -n '1s/^id \([0-9]*\),.*/\1/p'
}

# Print the level, then the output, then the input with its mute icon.
now() {
    local vol pct icon mic_icon
    vol=$(wp get-volume "$out") || { echo 'no sound: pipewire is not running'; return; }
    pct=$(echo "$vol" | awk '{printf "%.0f", $2 * 100}')
    case "$vol" in *MUTED*) icon='󰖁' ;; *) icon='󰕾' ;; esac
    case "$(wp get-volume "$mic" || true)" in *MUTED*) mic_icon='󰍭' ;; *) mic_icon='󰍬' ;; esac
    printf '%s %s %s%%\nout: %s\nin:  %s %s' "$icon" "$(line "$pct")" "$pct" \
        "$(name "$out")" "$mic_icon" "$(name "$mic" || true)"
}

# Pick a device: outputs first, then inputs, the current ones marked.
pick_device() {
    local id
    id=$(pw-dump 2>/dev/null | jq -r --arg o "$(default_id "$out")" --arg i "$(default_id "$mic")" '
        [.[] | select(.type == "PipeWire:Interface:Node")
             | select(.info.props["media.class"] == "Audio/Sink" or .info.props["media.class"] == "Audio/Source")]
        | sort_by(.info.props["media.class"] != "Audio/Sink")
        | .[]
        | (if .info.props["media.class"] == "Audio/Sink" then "Out" else "In " end) as $kind
        | (if (.id | tostring) == $o or (.id | tostring) == $i then "  (now)" else "" end) as $now
        | "\(.id)\t\($kind)  \(.info.props["node.description"] // .info.props["node.name"])\($now)"' |
        menu --delimiter='\t' --with-nth=2 |
        cut -f1) || return 0
    if [ -n "$id" ]; then
        wp set-default "$id"
    fi
}

# Print what a pick will do to a node: "Mute" or "Unmute".
action() {
    case "$(wp get-volume "$1" || true)" in *MUTED*) echo Unmute ;; *) echo Mute ;; esac
}

# Mute or unmute the sound or the mic. Esc goes back.
mute_menu() {
    local pick
    pick=$(printf '%s\n' "$(action "$out") volume" "$(action "$mic") mic" |
        menu --header="$(now)$gap") || return 0
    case "$pick" in
        *volume) wp set-mute "$out" toggle ;;
        *mic)    wp set-mute "$mic" toggle ;;
    esac
}

# Show the level. The same tag makes mako replace the last notification
# instead of stacking them.
notify_level() {
    local text
    text=$(now)
    ~/.local/bin/notify -a volume -t 1500 -h string:x-dunst-stack-tag:volume \
        "$(printf '%s\n' "$text" | head -n 1)" "$(printf '%s\n' "$text" | sed -n 2p)" || true
}

case "${1:-}" in
    up)   wp set-volume -l "$max" "$out" "$step+"; notify_level; exit 0 ;;
    down) wp set-volume "$out" "$step-"; notify_level; exit 0 ;;
    mute) wp set-mute "$out" toggle; notify_level; exit 0 ;;
esac

# 'pos' keeps the cursor on the last picked line.
pos=1
while :; do
    MENU_TEXT="$(now)$gap"
    pick=$(printf '%s\n' '(+) Volume' '(-) Volume' 'Mute/unmute >' 'In/out devices >' |
        menu --bind="$banner" --bind="load:pos($pos)") || exit 0
    case "$pick" in
        '(+) Volume')       pos=1; wp set-volume -l "$max" "$out" "$step+" ;;
        '(-) Volume')       pos=2; wp set-volume "$out" "$step-" ;;
        'Mute/unmute >')    pos=3; mute_menu ;;
        'In/out devices >') pos=4; pick_device ;;
    esac
done
