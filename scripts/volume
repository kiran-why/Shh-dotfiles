#!/bin/sh
# volume - sound menu: louder, quieter, mute, output device, mic mute
# opened by a click on the volume icon in swaybar (window size in sway/rules).
# Esc closes it

set -eu

out=@DEFAULT_AUDIO_SINK@
mic=@DEFAULT_AUDIO_SOURCE@
# volume step and the highest volume (1.0 = 100%)
step=5%
max=1.0

# same look as scripts/launcher
colors='fg:7,fg+:15,bg+:0,hl:15:underline,hl+:15:underline'
colors="$colors,info:8,border:8,label:15,prompt:15,pointer:15,query:15"
colors="$colors,separator:8,spinner:8,gutter:-1,header:7"

menu() {
    fzf --layout=reverse --border=sharp --info=hidden --prompt='> ' \
        --pointer='▌' --no-scrollbar --highlight-line --color="$colors" "$@"
}

# wpctl prints harmless "RTKit error" lines (no rtkit installed);
# they would mess up the menu, so its errors are hidden
wp() {
    wpctl "$@" 2>/dev/null
}

# line PERCENT: ━━━━━───── like on the bar
line() {
    local full=$((($1 + 5) / 10)) i=0 text=''
    [ "$full" -gt 10 ] && full=10
    while [ "$i" -lt 10 ]; do
        if [ "$i" -lt "$full" ]; then text="$text━"; else text="$text─"; fi
        i=$((i + 1))
    done
    printf '%s' "$text"
}

# the top of the menu: volume and the name of the output
now() {
    local vol pct icon name
    vol=$(wp get-volume "$out") || { echo 'no sound: pipewire is not running'; return; }
    pct=$(echo "$vol" | awk '{printf "%.0f", $2 * 100}')
    case "$vol" in *MUTED*) icon='󰖁' ;; *) icon='󰕾' ;; esac
    name=$(wp inspect "$out" | sed -n 's/.*node\.description = "\(.*\)"/\1/p' | head -n 1)
    printf '%s %s %s%%\n%s' "$icon" "$(line "$pct")" "$pct" "$name"
}

# list the outputs (pw-dump + jq), pick one, make it the default
pick_output() {
    local id
    id=$(pw-dump 2>/dev/null | jq -r '.[]
        | select(.type == "PipeWire:Interface:Node")
        | select(.info.props["media.class"] == "Audio/Sink")
        | "\(.id)\t\(.info.props["node.description"] // .info.props["node.name"])"' |
        menu --border-label=' output ' --delimiter='\t' --with-nth=2 |
        cut -f1)
    if [ -n "$id" ]; then
        wp set-default "$id"
    fi
}

# pos: the line the cursor starts on, so it stays where it was
pos=1
while :; do
    pick=$(printf '%s\n' louder quieter mute 'output device' 'mic mute' |
        menu --border-label=' volume ' --header="$(now)" --bind="load:pos($pos)") || exit 0
    case "$pick" in
        louder) pos=1; wp set-volume -l "$max" "$out" "$step+" ;;
        quieter) pos=2; wp set-volume "$out" "$step-" ;;
        mute) pos=3; wp set-mute "$out" toggle ;;
        'output device') pos=4; pick_output ;;
        'mic mute') pos=5; wp set-mute "$mic" toggle ;;
    esac
done
