#!/bin/sh
# volume - sound menu: volume up / down, mute, input and output devices
# opened from the volume icon in swaybar.
# volume up | down | mute: no menu, for the volume keys, shows the level

set -eu

out=@DEFAULT_AUDIO_SINK@
mic=@DEFAULT_AUDIO_SOURCE@
# the step and the max (1.0 = 100%)
step=5%
max=1.0

menu() {
    fzf --info=hidden "$@"
}

# wpctl prints harmless "RTKit error" lines that would mess up the menu
wp() {
    wpctl "$@" 2>/dev/null
}

# redraw the bar now, not on its next second (status.sh)
wake_bar() {
    kill -USR1 "$(cat "${XDG_RUNTIME_DIR:-/tmp}/shh-bar.pid" 2>/dev/null)" 2>/dev/null || true
}

# line PERCENT: ━━━━━─────
line() {
    local full=$((($1 + 5) / 10)) i=0 text=''
    [ "$full" -gt 10 ] && full=10
    while [ "$i" -lt 10 ]; do
        if [ "$i" -lt "$full" ]; then text="$text━"; else text="$text─"; fi
        i=$((i + 1))
    done
    printf '%s' "$text"
}

# name NODE: the device name people see
name() {
    wp inspect "$1" | sed -n 's/.*node\.description = "\(.*\)"/\1/p' | head -n 1
}

# default_id NODE: the id behind @DEFAULT_AUDIO_SINK@ / SOURCE@ ("id 45, type ...")
default_id() {
    wp inspect "$1" | sed -n '1s/^id \([0-9]*\),.*/\1/p'
}

# the level, then the output, then the input with its mute icon
now() {
    local vol pct icon mic_icon
    vol=$(wp get-volume "$out") || { echo 'no sound: pipewire is not running'; return; }
    pct=$(echo "$vol" | awk '{printf "%.0f", $2 * 100}')
    case "$vol" in *MUTED*) icon='󰖁' ;; *) icon='󰕾' ;; esac
    case "$(wp get-volume "$mic" || true)" in *MUTED*) mic_icon='󰍭' ;; *) mic_icon='󰍬' ;; esac
    printf '%s %s %s%%\nout: %s\nin:  %s %s' "$icon" "$(line "$pct")" "$pct" \
        "$(name "$out")" "$mic_icon" "$(name "$mic" || true)"
}

# outputs first, then inputs; the current ones are marked
pick_device() {
    local id
    id=$(pw-dump 2>/dev/null | jq -r --arg o "$(default_id "$out")" --arg i "$(default_id "$mic")" '
        [.[] | select(.type == "PipeWire:Interface:Node")
             | select(.info.props["media.class"] == "Audio/Sink" or .info.props["media.class"] == "Audio/Source")]
        | sort_by(.info.props["media.class"] != "Audio/Sink")
        | .[]
        | (if .info.props["media.class"] == "Audio/Sink" then "out" else "in " end) as $kind
        | (if (.id | tostring) == $o or (.id | tostring) == $i then "  (now)" else "" end) as $now
        | "\(.id)\t\($kind)  \(.info.props["node.description"] // .info.props["node.name"])\($now)"' |
        menu --border-label=' in/out devices ' --delimiter='\t' --with-nth=2 |
        cut -f1) || return 0
    if [ -n "$id" ]; then
        wp set-default "$id"
    fi
}

# action NODE: "mute" or "unmute", what a pick will do
action() {
    case "$(wp get-volume "$1" || true)" in *MUTED*) echo unmute ;; *) echo mute ;; esac
}

# mute or unmute the sound or the mic, Esc goes back
mute_menu() {
    local pick
    pick=$(printf '%s\n' "$(action "$out") volume" "$(action "$mic") mic" |
        menu --border-label=' mute/unmute ' --header="$(now)") || return 0
    case "$pick" in
        *volume) wp set-mute "$out" toggle ;;
        *mic)    wp set-mute "$mic" toggle ;;
    esac
}

# the same tag makes mako replace the last one instead of stacking them
notify_level() {
    local text
    text=$(now)
    notify-send -a volume -t 1500 -h string:x-dunst-stack-tag:volume \
        "$(printf '%s\n' "$text" | head -n 1)" "$(printf '%s\n' "$text" | sed -n 2p)"
}

case "${1:-}" in
    up)   wp set-volume -l "$max" "$out" "$step+"; wake_bar; notify_level; exit 0 ;;
    down) wp set-volume "$out" "$step-"; wake_bar; notify_level; exit 0 ;;
    mute) wp set-mute "$out" toggle; wake_bar; notify_level; exit 0 ;;
esac

# pos keeps the cursor on the last picked line
pos=1
while :; do
    pick=$(printf '%s\n' '(+) volume' '(-) volume' 'mute/unmute' 'in/out devices' |
        menu --border-label=' volume ' --header="$(now)" --bind="load:pos($pos)") || exit 0
    case "$pick" in
        '(+) volume')     pos=1; wp set-volume -l "$max" "$out" "$step+" ;;
        '(-) volume')     pos=2; wp set-volume "$out" "$step-" ;;
        'mute/unmute')    pos=3; mute_menu ;;
        'in/out devices') pos=4; pick_device ;;
    esac
    wake_bar
done
