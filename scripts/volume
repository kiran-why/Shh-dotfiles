#!/bin/sh
# volume - sound menu: louder, quieter, mute, output device, mic mute
# opened from the volume icon in swaybar.
# volume up | down | mute: no menu, for the volume keys, shows the level

set -eu

out=@DEFAULT_AUDIO_SINK@
mic=@DEFAULT_AUDIO_SOURCE@
# the step and the max (1.0 = 100%)
step=5%
max=1.0

menu() {
    fzf --info=hidden "$@"
}

# wpctl prints harmless "RTKit error" lines that would mess up the menu
wp() {
    wpctl "$@" 2>/dev/null
}

# line PERCENT: ━━━━━─────
line() {
    local full=$((($1 + 5) / 10)) i=0 text=''
    [ "$full" -gt 10 ] && full=10
    while [ "$i" -lt 10 ]; do
        if [ "$i" -lt "$full" ]; then text="$text━"; else text="$text─"; fi
        i=$((i + 1))
    done
    printf '%s' "$text"
}

# the volume and the output name
now() {
    local vol pct icon name
    vol=$(wp get-volume "$out") || { echo 'no sound: pipewire is not running'; return; }
    pct=$(echo "$vol" | awk '{printf "%.0f", $2 * 100}')
    case "$vol" in *MUTED*) icon='󰖁' ;; *) icon='󰕾' ;; esac
    name=$(wp inspect "$out" | sed -n 's/.*node\.description = "\(.*\)"/\1/p' | head -n 1)
    printf '%s %s %s%%\n%s' "$icon" "$(line "$pct")" "$pct" "$name"
}

# pick an output and make it the default
pick_output() {
    local id
    id=$(pw-dump 2>/dev/null | jq -r '.[]
        | select(.type == "PipeWire:Interface:Node")
        | select(.info.props["media.class"] == "Audio/Sink")
        | "\(.id)\t\(.info.props["node.description"] // .info.props["node.name"])"' |
        menu --border-label=' output ' --delimiter='\t' --with-nth=2 |
        cut -f1)
    if [ -n "$id" ]; then
        wp set-default "$id"
    fi
}

# the same tag makes mako replace the last one instead of stacking them
notify_level() {
    local text
    text=$(now)
    notify-send -a volume -t 1500 -h string:x-dunst-stack-tag:volume \
        "$(printf '%s\n' "$text" | head -n 1)" "$(printf '%s\n' "$text" | sed -n 2p)"
}

case "${1:-}" in
    up)   wp set-volume -l "$max" "$out" "$step+"; notify_level; exit 0 ;;
    down) wp set-volume "$out" "$step-"; notify_level; exit 0 ;;
    mute) wp set-mute "$out" toggle; notify_level; exit 0 ;;
esac

# pos keeps the cursor on the last picked line
pos=1
while :; do
    pick=$(printf '%s\n' louder quieter mute 'output device' 'mic mute' |
        menu --border-label=' volume ' --header="$(now)" --bind="load:pos($pos)") || exit 0
    case "$pick" in
        louder) pos=1; wp set-volume -l "$max" "$out" "$step+" ;;
        quieter) pos=2; wp set-volume "$out" "$step-" ;;
        mute) pos=3; wp set-mute "$out" toggle ;;
        'output device') pos=4; pick_output ;;
        'mic mute') pos=5; wp set-mute "$mic" toggle ;;
    esac
done
