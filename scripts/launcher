#!/bin/sh
# launcher - pick a program from $PATH with fzf and start it
# opened by $mod+r in a floating foot window (size in sway/rules).
# console programs (htop, nvim) get their own foot window, its app id is
# the program name, so menus (wifi, volume, keys) float by their sway/rules

set -eu

# not listed: sway and other scripts start these, a second copy would clash
hidden='autotile sound hardware wallpaper vmware-clipboard'

# programs: every executable file in $PATH, without duplicates
programs() {
    local IFS=: dir f
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] && [ -x "$f" ] || continue
            case " $hidden " in *" ${f##*/} "*) continue ;; esac
            echo "${f##*/}"
        done
    done | sort -u
}

# is_gui CMD: a .desktop file runs CMD and has no Terminal=true.
# no .desktop at all = console program
is_gui() {
    local cmd="$1" f
    set --  # the .desktop files that exist; awk stops on a missing one
    for f in /usr/share/applications/*.desktop \
             "$HOME"/.local/share/applications/*.desktop; do
        [ -f "$f" ] || continue
        set -- "$@" "$f"
    done
    [ $# -gt 0 ] || return 1

    awk -v cmd="$cmd" '
        function check() { if (found && !term) gui = 1; found = 0; term = 0 }
        FNR == 1 { check() }
        /^Exec=/ {
            split(substr($0, 6), word, " ")
            n = split(word[1], part, "/")
            if (part[n] == cmd) found = 1
        }
        /^Terminal=true/ { term = 1 }
        END { check(); exit !gui }
    ' "$@"
}

# colors are numbers of the foot palette (foot.ini): 7 text, 15 white,
# 8 gray, 0 dark gray. Same look in scripts/volume and scripts/wifi
colors='fg:7,fg+:15,bg+:0,hl:15:underline,hl+:15:underline'
colors="$colors,info:8,border:8,label:15,prompt:15,pointer:15,query:15"
colors="$colors,separator:8,spinner:8,gutter:-1"

cmd=$(programs | fzf \
    --layout=reverse \
    --border=sharp \
    --border-label=' run ' \
    --info=inline-right \
    --prompt='> ' \
    --pointer='▌' \
    --no-scrollbar \
    --highlight-line \
    --color="$colors") || exit 0

if is_gui "$cmd"; then
    swaymsg exec "$cmd" >/dev/null
else
    swaymsg exec "foot --app-id=$cmd $cmd" >/dev/null
fi
