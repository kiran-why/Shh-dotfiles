#!/bin/sh
# launcher - pick a program from $PATH and start it ($mod+r)
# console programs open in their own foot, app id = program name,
# so menus like wifi and keys float by their sway/rules

set -eu

# started by sway or a key: from here a second copy would clash, record and
# screenshot would catch their own terminal window
hidden='autotile sound hardware wallpaper vmware-clipboard record screenshot'

# every executable in $PATH, without duplicates
programs() {
    local IFS=: dir f
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] && [ -x "$f" ] || continue
            case " $hidden " in *" ${f##*/} "*) continue ;; esac
            echo "${f##*/}"
        done
    done | sort -u
}

# is_gui CMD: some .desktop file runs CMD without Terminal=true
is_gui() {
    local cmd="$1" f
    set --
    for f in /usr/share/applications/*.desktop \
             "$HOME"/.local/share/applications/*.desktop; do
        [ -f "$f" ] || continue
        set -- "$@" "$f"
    done
    [ $# -gt 0 ] || return 1

    awk -v cmd="$cmd" '
        function check() { if (found && !term) gui = 1; found = 0; term = 0 }
        FNR == 1 { check() }
        /^Exec=/ {
            split(substr($0, 6), word, " ")
            n = split(word[1], part, "/")
            if (part[n] == cmd) found = 1
        }
        /^Terminal=true/ { term = 1 }
        END { check(); exit !gui }
    ' "$@"
}

cmd=$(programs | fzf --border-label=' run ') || exit 0

if is_gui "$cmd"; then
    swaymsg exec "$cmd" >/dev/null
else
    swaymsg exec "footclient --app-id=$cmd $cmd" >/dev/null
fi
