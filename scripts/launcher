#!/bin/sh
# launcher - pick a program from /usr/bin with fzf and start it
# opened by $mod+r in a floating foot window (size in sway/rules)

set -eu

# colors are numbers of the foot palette (foot.ini): 7 text, 15 white,
# 8 gray, 0 dark gray. Same look in scripts/volume and scripts/wifi
colors='fg:7,fg+:15,bg+:0,hl:15:underline,hl+:15:underline'
colors="$colors,info:8,border:8,label:15,prompt:15,pointer:15,query:15"
colors="$colors,separator:8,spinner:8,gutter:-1"

cmd=$(ls /usr/bin | fzf \
    --layout=reverse \
    --border=sharp \
    --border-label=' run ' \
    --info=inline-right \
    --prompt='> ' \
    --pointer='▌' \
    --no-scrollbar \
    --highlight-line \
    --color="$colors") || exit 0

swaymsg exec "$cmd" >/dev/null
