#!/bin/sh
# Pick a program from $PATH and start it ($mod+r).
#
# Console programs open in their own foot with the program name as the
# app id, so menus like wifi and keys float by their sway/rules.

set -eu

# Started by sway or a key. From here a second copy would clash, and
# record and screenshot would catch their own terminal window.
hidden='autotile sound hardware wallpaper vmware-clipboard notify record screenshot maxhz'

# Print every executable in $PATH, without duplicates.
programs() {
    local IFS=: dir f
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] && [ -x "$f" ] || continue
            case " $hidden " in *" ${f##*/} "*) continue ;; esac
            echo "${f##*/}"
        done
    done | sort -u
}

# Check if some .desktop file runs CMD without 'Terminal=true'.
is_gui() {
    local cmd="$1" f
    set --
    for f in /usr/share/applications/*.desktop \
             "$HOME"/.local/share/applications/*.desktop; do
        [ -f "$f" ] || continue
        set -- "$@" "$f"
    done
    [ $# -gt 0 ] || return 1

    awk -v cmd="$cmd" '
        function check() { if (found && !term) gui = 1; found = 0; term = 0 }
        FNR == 1 { check() }
        /^Exec=/ {
            split(substr($0, 6), word, " ")
            n = split(word[1], part, "/")
            if (part[n] == cmd) found = 1
        }
        /^Terminal=true/ { term = 1 }
        END { check(); exit !gui }
    ' "$@"
}

cmd=$(programs | fzf --border-label=' Run ') || exit 0

if is_gui "$cmd"; then
    swaymsg exec "$cmd" >/dev/null
else
    swaymsg exec "footclient --app-id=$cmd $cmd" >/dev/null
fi
