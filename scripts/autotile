#!/bin/sh
# autotile - hyprland-like dwindle: a new window halves the focused one
# along its longer side. Started once by sway (sway/features/autotile)
# autotile drag: the focused window follows the cursor until the sway mode
# "drag" ends, then it halves the window it was dropped on

set -eu

# how often a dragged window moves, seconds
drag_step=0.01

# rect ID: "x y width height" of the window
rect() {
    swaymsg -t get_tree | jq -r --argjson id "$1" '
        recurse(.nodes[]?, .floating_nodes[]?) | select(.id == $id)
        | "\(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height)"'
}

# tiled_at X Y: "id x y width height" of the tiled window at that point
tiled_at() {
    swaymsg -t get_tree | jq -r --argjson x "$1" --argjson y "$2" '
        recurse(.nodes[]?)
        | select(.type == "con" and .visible == true and (.nodes | length) == 0
            and .rect.x <= $x and $x < .rect.x + .rect.width
            and .rect.y <= $y and $y < .rect.y + .rect.height)
        | "\(.id) \(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height)"'
}

# sway can't drag a tiled window live and doesn't tell where the cursor is,
# but "move position cursor" centers a floating window on it: float the
# window, then repeat that, shifted by where it was grabbed
drag() {
    local id type x y w h dx dy step cx cy split cmd
    # the mode has no keybinds: never stay in it
    trap 'swaymsg mode default >/dev/null' EXIT
    trap 'exit 1' INT TERM

    # shortcut: drags the focused window, with focus moved by keys and the mouse still it may not be the one under the cursor
    set -- $(swaymsg -t get_tree | jq -r '
        recurse(.nodes[]?, .floating_nodes[]?) | select(.focused)
        | "\(.id) \(.type) \(.fullscreen_mode // 0) \(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height)"')
    [ "$#" -eq 7 ] && [ "$3" -eq 0 ] || return 0
    id=$1 type=$2 x=$4 y=$5 w=$6 h=$7
    case "$type" in
        con|floating_con) ;;
        *) return 0 ;;
    esac

    swaymsg "[con_id=$id] floating enable, resize set $w $h, move position cursor" >/dev/null
    set -- $(rect "$id")
    [ "$#" -eq 4 ] || return 0
    dx=$(($1 + $3 / 2 - x - w / 2))
    dy=$(($2 + $4 / 2 - y - h / 2))

    step="[con_id=$id] move position cursor"
    [ "$dx" -le 0 ] || step="$step, move left $dx px"
    [ "$dx" -ge 0 ] || step="$step, move right $((-dx)) px"
    [ "$dy" -le 0 ] || step="$step, move up $dy px"
    [ "$dy" -ge 0 ] || step="$step, move down $((-dy)) px"

    # features/autotile ends the mode when the button goes up
    while case "$(swaymsg -t get_binding_state)" in *'"drag"'*) ;; *) false ;; esac; do
        # fails when the window was closed
        swaymsg "$step" >/dev/null || return 0
        sleep "$drag_step"
    done

    # a floating window stays where it was dropped
    [ "$type" = con ] || return 0

    # the cursor again: the center of the window
    swaymsg "[con_id=$id] move position cursor" >/dev/null || return 0
    set -- $(rect "$id")
    [ "$#" -eq 4 ] || return 0
    cx=$(($1 + $3 / 2)) cy=$(($2 + $4 / 2))

    # one command list, so the loop below can't get between the steps
    cmd="[con_id=$id] floating disable"
    set -- $(tiled_at "$cx" "$cy")
    if [ "$#" -ge 5 ]; then
        if [ "$5" -gt "$4" ]; then split=splitv; else split=splith; fi
        cmd="[con_id=$1] mark --add _drag; [con_id=$1] $split; $cmd; [con_id=$id] move container to mark _drag; [con_id=$1] unmark _drag"
        # like hyprland: the half of the window the cursor is in
        if { [ "$split" = splith ] && [ "$cx" -lt $(($2 + $4 / 2)) ]; } ||
            { [ "$split" = splitv ] && [ "$cy" -lt $(($3 + $5 / 2)) ]; }; then
            cmd="$cmd; [con_id=$id] swap container with con_id $1"
        fi
        cmd="$cmd; [con_id=$id] focus"
    fi
    swaymsg "$cmd" >/dev/null || true
}

if [ "${1:-}" = drag ]; then
    drag
    exit 0
fi

# the focused window and its parent:
# "id type fullscreen width height parent_layout siblings"
focused='
[.. | objects | select(.nodes? and any(.nodes[]; .focused))]
| first // empty
| . as $parent
| ($parent.nodes[] | select(.focused)) as $win
| "\($win.id) \($win.type) \($win.fullscreen_mode // 0) \($win.rect.width) \($win.rect.height) \($parent.layout) \($parent.nodes | length)"
'

swaymsg -t subscribe -m '["window"]' | jq --unbuffered -r '.change' |
while read -r change; do
    case "$change" in
        title|mark|urgent) continue ;;
    esac

    info=$(swaymsg -t get_tree | jq -r "$focused") || continue
    [ -n "$info" ] || continue

    set -- $info
    id=$1 type=$2 fullscreen=$3 width=$4 height=$5 layout=$6 siblings=$7

    # leave floating, fullscreen, stacked and tabbed windows alone
    [ "$type" = con ] && [ "$fullscreen" -eq 0 ] || continue
    case "$layout" in
        stacked|tabbed) continue ;;
    esac

    if [ "$height" -gt "$width" ]; then
        split=splitv
    else
        split=splith
    fi

    if [ "$siblings" -eq 1 ] && [ "$layout" = "$split" ]; then
        continue
    fi

    swaymsg "[con_id=$id] $split" >/dev/null || true
done
