#!/bin/sh
# screen - screens off, or back on ($mod+Escape); the mouse doesn't wake them

set -eu

# sway has no toggle for all outputs at once
if swaymsg -t get_outputs | jq -e 'any(.[]; .power)' >/dev/null; then
    swaymsg 'output * power off' >/dev/null
else
    swaymsg 'output * power on' >/dev/null
fi
