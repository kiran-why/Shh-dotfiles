#!/bin/sh -e

# Latin, greek and cyrillic: the text fonts for pages and programs.
for zip in ./*.zip; do
    # '-o': both zips have an AUTHORS.txt. Without it unzip asks, and there
    # is no stdin.
    unzip -o -q "$zip"
done

mkdir -p "$1/usr/share/fonts/TTF"
cp NotoSans/hinted/ttf/*.ttf NotoSerif/hinted/ttf/*.ttf "$1/usr/share/fonts/TTF/"
