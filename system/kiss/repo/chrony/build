#!/bin/sh -e

./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --mandir=/usr/share/man

make
make DESTDIR="$1" install

install -Dm644 examples/chrony.conf.example1 "$1/etc/chrony.conf"
mkdir -p "$1/var/lib/chrony"

# The runit service, the way KISS packages ship them.
mkdir -p "$1/etc/sv/chronyd"
cp -f chronyd.run "$1/etc/sv/chronyd/run"
ln -sf /run/runit/supervise.chronyd "$1/etc/sv/chronyd/supervise"
