#!/bin/sh -e

# the tarball has no top directory: kiss would strip a level of the tree
# the file keeps its ?no-extract suffix
xz -dc ./7z*-src.tar.xz* | tar xf -

# upstream has -Werror on, a new compiler warning must not stop the build
sed -i "s/-Werror //" CPP/7zip/7zip_gcc.mak

make -C CPP/7zip/Bundles/Alone2 -f ../../cmpl_gcc.mak \
    CC="$CC $CFLAGS $LDFLAGS" CXX="$CXX $CXXFLAGS $LDFLAGS"

install -Dm755 CPP/7zip/Bundles/Alone2/b/g/7zz "$1/usr/bin/7zz"
ln -s 7zz "$1/usr/bin/7z"
