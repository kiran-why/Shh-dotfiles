#!/bin/sh -e

export DESTDIR="$1"

for p in *.patch; do
    patch -p1 < "$p"
done

sed "/subdir('po'/d" subprojects/wireplumber/meson.build > _
mv -f _ subprojects/wireplumber/meson.build

# Build Bluetooth audio, which community's recipe leaves out.
#
# The bluez5 plugin talks to bluetoothd over D-Bus, so 'dbus' is turned
# on too. 'enabled' makes the build fail instead of quietly skipping
# Bluetooth when a dependency is missing.
#
# Only SBC (and the built-in G.722) is kept. The other codecs are turned
# off by hand: on 'auto' they would link to whatever happens to be
# installed (opus, fdk-aac) without being in depends.
meson \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    -Ddbus=enabled \
    -Dbluez5=enabled \
    -Dbluez5-codec-aptx=disabled \
    -Dbluez5-codec-ldac=disabled \
    -Dbluez5-codec-ldac-dec=disabled \
    -Dbluez5-codec-aac=disabled \
    -Dbluez5-codec-lc3plus=disabled \
    -Dbluez5-codec-opus=disabled \
    -Dbluez5-codec-lc3=disabled \
    -Dbluez5-plc-spandsp=disabled \
    -Dsndfile=enabled \
    -Djack=disabled \
    -Dpipewire-jack=disabled \
    -Dtests=disabled \
    -Dudev=enabled \
    -Dudevrulesdir=/usr/lib/udev/rules.d \
    -Dsession-managers=wireplumber \
    -Dwireplumber:system-lua=true \
    . output

ninja -C output
ninja -C output install
