#!/bin/sh
# KISS owns this temporary path and publishes it to its source cache on success.
[ "$#" = 2 ] || exit 2
output=$1
url=$2
delay=2
trap 'rm -f -- "$output"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

while :; do
    rc=0
    status=$(curl -q -fL --globoff --connect-timeout 15 --speed-limit 1 --speed-time 60 \
        -w '%{http_code}' -o "$output" -- "$url") || rc=$?
    case "$rc:$status" in
        0:[345][0-9][0-9]) exit 22 ;;
        0:*) trap - EXIT; exit 0 ;;
        22:408|22:429|22:500|22:502|22:503|22:504) ;;
        5:*|6:*|7:*|16:*|18:*|28:*|52:*|55:*|56:*|92:*) ;;
        *) exit "$rc" ;;
    esac
    [ "$delay" -le 16 ] || exit "$rc"
    rm -f -- "$output" || exit 1
    printf '  ! download failed (curl %s, status %s), retrying in %ss\n' "$rc" "$status" "$delay" >&2
    sleep "$delay" || exit $?
    delay=$((delay * 2))
done
