# ~/.config/swaybar/bar - workspaces on the left, status.sh on the right

bar {
    position top
    # the text font, then the icons
    font pango:Fira Code, Symbols Nerd Font 10
    status_command ~/.config/swaybar/status.sh
    # space after the menu button at the right edge, px (default 3)
    status_edge_padding 6
    # no tray: swaybar always draws it right of the menu button
    tray_output none

    # show "●" instead of "1:●"
    strip_workspace_numbers yes

    colors {
        background $black
        statusline $gray
        separator  $dark

        # class            border  backgr. text
        focused_workspace  $black  $black  $white
        active_workspace   $black  $black  $white
        inactive_workspace $black  $black  $gray
        urgent_workspace   $black  $black  $red
    }
}
