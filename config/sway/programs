# Programs for the keys, and what starts with sway.

# Terminals are footclient windows of one foot server: a few MB each,
# not 25.
set $term footclient
set $menu footclient --app-id=launcher ~/.local/bin/launcher

# 'exec' runs once per session, 'exec_always' also on every reload. A
# running server makes the new one quit, a crashed one is restarted on
# reload.
exec_always foot --server
exec ~/.local/bin/sound

# The shared clipboard in VMware (scripts/vmware-clipboard).
exec_always ~/.local/bin/vmware-clipboard
