# ~/.config/sway/programs - programs for the keys, and what starts with sway

set $term foot
set $browser firefox
# floats like the launcher (sway/rules)
set $files foot --app-id=files broot
set $menu foot --app-id=launcher ~/.local/bin/launcher

# exec: once per session, exec_always: also on every reload
exec ~/.local/bin/sound
exec mako
# clipboard history (scripts/clipboard)
exec wl-paste --watch cliphist store

# shared clipboard in VMware (scripts/vmware-clipboard)
exec_always ~/.local/bin/vmware-clipboard
