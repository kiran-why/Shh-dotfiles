# ~/.config/sway/programs - programs for the keys, and what starts with sway

set $term foot
set $browser firefox
set $files foot broot
set $menu foot --app-id=launcher ~/.local/bin/launcher

# exec: once per session (exec_always would also run on every reload)
exec ~/.local/bin/sound
exec mako

# VMware shared clipboard (Wayland) - only runs if tools are present and in VMware
exec_always sh -c 'grep -qi vmware /sys/devices/virtual/dmi/id/product_name 2>/dev/null || grep -qi vmware /sys/devices/virtual/dmi/id/sys_vendor 2>/dev/null || exit; command -v vmtoolsd >/dev/null 2>&1 || exit; mkdir -p "$HOME/.local/lib/clipway"; ln -sf /usr/lib/open-vm-tools/plugins/vmusr/libdndcp.so "$HOME/.local/lib/clipway/libdndcp.so"; pgrep -u "$(id -u)" -x vmtoolsd >/dev/null && exit; env -u DISPLAY XDG_SESSION_TYPE=wayland vmtoolsd -n vmusr --plugin-path "$HOME/.local/lib/clipway" >/dev/null 2>&1 &'
