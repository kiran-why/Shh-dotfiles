# ~/.config/sway/keybinds - keys for programs and windows
# workspace keys live in workspaces; every key is listed in README

# Mod4 = the Windows key
set $mod Mod4

# programs
bindsym $mod+t exec $term
bindsym $mod+b exec $browser
bindsym $mod+f exec $files
bindsym $mod+r exec $menu

# windows
bindsym $mod+q kill
bindsym $mod+Shift+f fullscreen
bindsym $mod+v floating toggle

# leave sway (asks first)
bindsym $mod+l exec swaynag -t warning -m 'exit sway?' -B 'yes, exit' 'swaymsg exit'

# screenshot of a region: saved and copied (scripts/screenshot)
bindsym Print exec ~/.local/bin/screenshot

# reload this config after editing
bindsym $mod+Shift+c reload

# drag a window with $mod + left mouse, resize it with $mod + right mouse
floating_modifier $mod normal

# focus with $mod + arrows, move the window with $mod + Shift + arrows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# volume keys (laptop). VERIFY: needs pipewire running, not started yet
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
