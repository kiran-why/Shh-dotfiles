# ~/.config/sway/keybinds - keys for programs and windows
# workspace keys live in workspaces; every key is listed in README

# Mod4 = the Windows key
set $mod Mod4

# programs
bindsym --to-code $mod+t exec $term
bindsym --to-code $mod+b exec $browser
bindsym --to-code $mod+f exec $files
bindsym --to-code $mod+r exec $menu

# windows
bindsym --to-code $mod+q kill
bindsym --to-code $mod+Shift+f fullscreen
bindsym --to-code $mod+v floating toggle

# leave sway (asks first)
bindsym --to-code $mod+l exec swaynag -t warning -m 'exit sway?' -B 'yes, exit' 'swaymsg exit'

# screenshot of a region: saved and copied (scripts/screenshot)
bindsym --to-code Print exec ~/.local/bin/screenshot

# screens off / on (scripts/screen)
bindsym --to-code $mod+Escape exec ~/.local/bin/screen

# reload this config after editing
bindsym --to-code $mod+Shift+c reload

# drag a window with $mod + left mouse, resize it with $mod + right mouse
floating_modifier $mod normal

# focus with $mod + arrows, move the window with $mod + Shift + arrows
bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right
bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right

# volume keys (laptop); 5% is the step, -l 1.0 the max (100%)
bindsym --to-code XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --to-code XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --to-code XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
