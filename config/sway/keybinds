# ~/.config/sway/keybinds - keys for programs and windows
# workspace keys are in workspaces, all keys are in README.
# --to-code: works on the ru layout; --no-repeat: a stuck key runs it once

# Mod4 = the Windows key
set $mod Mod4

# programs
bindsym --to-code --no-repeat $mod+t exec $term
bindsym --to-code --no-repeat $mod+b exec $browser
bindsym --to-code --no-repeat $mod+f exec $files
bindsym --to-code --no-repeat $mod+r exec $menu

# windows
bindsym --to-code --no-repeat $mod+q kill
bindsym --to-code --no-repeat $mod+Shift+f fullscreen
bindsym --to-code --no-repeat $mod+v floating toggle

# leave sway (asks first)
bindsym --to-code --no-repeat $mod+l exec swaynag -t warning -m 'exit sway?' -B 'yes, exit' 'swaymsg exit'

# screenshot of a region: saved and copied (scripts/screenshot)
bindsym --to-code --no-repeat Print exec ~/.local/bin/screenshot

# screenshot of all screens
bindsym --to-code --no-repeat Ctrl+Print exec ~/.local/bin/screenshot full

# screen recording: start, press again to stop (scripts/record)
bindsym --to-code --no-repeat Shift+Print exec ~/.local/bin/record

# screens off / on (scripts/screen)
bindsym --to-code --no-repeat $mod+Escape exec ~/.local/bin/screen

# clipboard history (scripts/clipboard)
bindsym --to-code --no-repeat $mod+c exec footclient --app-id=clipboard ~/.local/bin/clipboard

# list of all keys, searchable (scripts/keys)
bindsym --to-code --no-repeat $mod+slash exec footclient --app-id=keys ~/.local/bin/keys

# reload this config after editing
bindsym --to-code --no-repeat $mod+Shift+c reload

# drag a window with $mod + left mouse, resize it with $mod + right mouse
floating_modifier $mod normal

# focus with $mod + arrows, move the window with $mod + Shift + arrows
bindsym --to-code --no-repeat $mod+Left focus left
bindsym --to-code --no-repeat $mod+Down focus down
bindsym --to-code --no-repeat $mod+Up focus up
bindsym --to-code --no-repeat $mod+Right focus right
bindsym --to-code --no-repeat $mod+Shift+Left move left
bindsym --to-code --no-repeat $mod+Shift+Down move down
bindsym --to-code --no-repeat $mod+Shift+Up move up
bindsym --to-code --no-repeat $mod+Shift+Right move right

# volume keys (laptop), the level shows in a notification
# (the step and the max are in scripts/volume)
bindsym --to-code XF86AudioRaiseVolume exec ~/.local/bin/volume up
bindsym --to-code XF86AudioLowerVolume exec ~/.local/bin/volume down
bindsym --to-code --no-repeat XF86AudioMute exec ~/.local/bin/volume mute

# notifications (mako): close the top one, close all, bring the last one back
bindsym --to-code --no-repeat $mod+n exec makoctl dismiss
bindsym --to-code --no-repeat $mod+Shift+n exec makoctl dismiss -a
bindsym --to-code --no-repeat $mod+Ctrl+n exec makoctl restore
