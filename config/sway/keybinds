# Keys for programs and windows.
#
# Workspace keys are in workspaces, the keys of the parts 'shh config'
# can turn off in features/. The first comment line of a block says what
# the key does: Super+/ shows it (scripts/keys), so it stays a short label.
#
# '--to-code' makes a key work on the ru layout, '--no-repeat' makes a
# stuck key run it once.

# Mod4 is the Windows key.
set $mod Mod4

# terminal
bindsym --to-code --no-repeat $mod+t exec $term

# launcher
bindsym --to-code --no-repeat $mod+r exec $menu

# menu: wifi, volume, bluez, vpn, prefs, power (the bar button)
bindsym --to-code --no-repeat $mod+m exec ~/.local/bin/menu open

# close the window
bindsym --to-code --no-repeat $mod+q kill

# fullscreen
bindsym --to-code --no-repeat $mod+Shift+f fullscreen

# float / tile
bindsym --to-code --no-repeat $mod+v floating toggle

# power: exit sway, power off, reboot, sleep
bindsym --to-code --no-repeat $mod+l exec footclient --app-id=power ~/.local/bin/power

# lock, screens off; again: screens on
# '--locked' makes it work while locked too.
bindsym --to-code --no-repeat --locked $mod+Escape exec ~/.local/bin/lock

# all keys (this list)
bindsym --to-code --no-repeat $mod+slash exec ~/.local/bin/keys open

# reload the config
bindsym --to-code --no-repeat $mod+Shift+c reload

# Drag a window with $mod + left mouse, resize it with $mod + right mouse.
floating_modifier $mod normal

# focus another window
bindsym --to-code --no-repeat $mod+Left focus left
bindsym --to-code --no-repeat $mod+Down focus down
bindsym --to-code --no-repeat $mod+Up focus up
bindsym --to-code --no-repeat $mod+Right focus right

# move the window
bindsym --to-code --no-repeat $mod+Shift+Left move left
bindsym --to-code --no-repeat $mod+Shift+Down move down
bindsym --to-code --no-repeat $mod+Shift+Up move up
bindsym --to-code --no-repeat $mod+Shift+Right move right

# volume up / down / mute
# The level shows in a notification. The step and the max are in
# scripts/volume.
bindsym --to-code XF86AudioRaiseVolume exec ~/.local/bin/volume up
bindsym --to-code XF86AudioLowerVolume exec ~/.local/bin/volume down
bindsym --to-code --no-repeat XF86AudioMute exec ~/.local/bin/volume mute

# brightness up / down
# The level shows in a notification. The step is in scripts/brightness.
bindsym --to-code XF86MonBrightnessUp exec ~/.local/bin/brightness up
bindsym --to-code XF86MonBrightnessDown exec ~/.local/bin/brightness down
