# ~/.config/sway/rules - floating windows and their size (width height)

for_window [app_id="launcher"] floating enable, resize set 600 400, move position center
for_window [app_id="wifi"] floating enable, resize set 600 400, move position center
for_window [app_id="bluetooth"] floating enable, resize set 600 400, move position center
for_window [app_id="volume"] floating enable, resize set 500 300, move position center
for_window [app_id="files"] floating enable, resize set 1000 650, move position center
for_window [app_id="keys"] floating enable, resize set 900 600, move position center
