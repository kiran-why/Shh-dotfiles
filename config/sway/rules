# Floating windows and their size (width height).
#
# Menus from the bar go to the top right corner. 'ppt' is % of the
# workspace (it starts under the bar), x is 100 minus the width.

# The bar menu (scripts/menu) is wider, for the MENU banner, and its menus
# open in it. A height of 0 keeps it: 'menu open' makes the window as
# tall as the menu.
for_window [app_id="menu"] floating enable, resize set 25 ppt 0, move position 75 ppt 0 ppt
for_window [app_id="launcher"] floating enable, resize set 600 400, move position center
for_window [app_id="wifi"] floating enable, resize set 25 ppt 21 ppt, move position 75 ppt 0 ppt
for_window [app_id="volume"] floating enable, resize set 25 ppt 21 ppt, move position 75 ppt 0 ppt
for_window [app_id="brightness"] floating enable, resize set 25 ppt 21 ppt, move position 75 ppt 0 ppt
for_window [app_id="power"] floating enable, resize set 25 ppt 21 ppt, move position 75 ppt 0 ppt
for_window [app_id="settings"] floating enable, resize set 25 ppt 21 ppt, move position 75 ppt 0 ppt
for_window [app_id="keys"] floating enable, resize set 900 600, move position center
