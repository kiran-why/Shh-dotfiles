# ~/.config/sway/look - wallpaper, borders, gaps, colors

# wallpaper: the newest picture in ~/wallpapers, black if none (scripts/wallpaper)
output * bg $black solid_color
exec_always ~/.local/bin/wallpaper

# border width in px; gaps between windows
default_border pixel 2
default_floating_border pixel 2
gaps inner 0

# hyprland-like splits (scripts/autotile)
exec ~/.local/bin/autotile

# colors come from sway/colors
# class                 border  backgr. text    indicator child_border
client.focused          $white  $white  $black  $white    $white
client.focused_inactive $dark   $black  $gray   $dark     $dark
client.unfocused        $dark   $black  $gray   $dark     $dark
client.urgent           $red    $red    $black  $red      $red

font monospace 10

# no X11 programs: everything we use speaks wayland natively
xwayland disable
