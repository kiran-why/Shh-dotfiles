# ~/.config/sway/config - Shh... dotfiles: plain tiling, plain bar
# loads the other files, one topic each. Order matters: colors and
# programs first, $mod (keybinds) before workspaces. Reload: $mod+Shift+c

include ~/.config/sway/colors
include ~/.config/sway/programs
include ~/.config/sway/look
include ~/.config/sway/input
include ~/.config/sway/rules
include ~/.config/sway/keybinds
include ~/.config/sway/workspaces
# parts shh config can turn off; only the ones turned on are installed
include ~/.config/sway/features/*
include ~/.config/swaybar/bar
