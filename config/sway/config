# Shh... dotfiles: plain tiling, plain bar.
#
# This file loads the others, one topic each. The order matters: colors
# and programs first, $mod (keybinds) before workspaces. Reload with
# $mod+Shift+c.

include ~/.config/sway/colors
include ~/.config/sway/programs
include ~/.config/sway/look
include ~/.config/sway/input
include ~/.config/sway/rules
include ~/.config/sway/keybinds
include ~/.config/sway/workspaces
# The parts 'shh config' can turn off. Only the ones turned on are
# installed.
include ~/.config/sway/features/*
include ~/.config/swaybar/bar
# Not on every distro: sway without tray support errors on it. A missing
# file is skipped.
include ~/.config/swaybar/tray
