# Hyprland-like splits (shh config: autotile).

exec ~/.local/bin/autotile

# 'autotile drag' finds the cursor with a 1x1 window, and the default
# minimum is 75x50.
floating_minimum_size -1 x -1

# drag a window, it follows the cursor
bindsym --to-code --no-repeat --whole-window $mod+button1 mode drag, exec ~/.local/bin/autotile drag

# Only while dragging. Both releases, as Super may go up first. A click
# or Esc too: over the bar sway doesn't see the button go up.
mode drag {
    bindsym --to-code --no-repeat --whole-window --release button1 mode default
    bindsym --to-code --no-repeat --whole-window --release $mod+button1 mode default
    bindsym --to-code --no-repeat --whole-window button1 mode default
    bindsym --to-code --no-repeat --whole-window $mod+button1 mode default
    bindsym --to-code --no-repeat Escape mode default
}
