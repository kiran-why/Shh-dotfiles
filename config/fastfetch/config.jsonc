// ~/.config/fastfetch/config.jsonc - system info in every new foot window
// rows are "│ icon Name │ │ value │"; a value is padded to 34 columns
// ({name<34}), keep that width when adding a row or the box breaks.
// colors: {#90} border, {#37} names, {#97} values, {#} reset.
// check: fastfetch -c ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "artix_small",
        // the small logo has one color ($1)
        "color": {
            "1": "white"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "37",
            "title": "97"
        }
    },
    "modules": [
        // one box: system and hardware
        { "type": "custom", "format": "{#90}┌────────────┐ ┌────────────────────────────────────┐" },
        { "type": "os",         "key": "{#90}│{#37}  OS       {#90}│", "format": "{#90}│{#97} {pretty-name<34} {#90}│{#}" },
        { "type": "kernel",     "key": "{#90}│{#37}  Kernel   {#90}│", "format": "{#90}│{#97} {release<34} {#90}│{#}" },
        { "type": "initsystem", "key": "{#90}│{#37}  Init     {#90}│", "format": "{#90}│{#97} {name<34} {#90}│{#}" },
        { "type": "uptime",     "key": "{#90}│{#37}  Uptime   {#90}│", "format": "{#90}│{#97} {formatted<34} {#90}│{#}" },
        { "type": "packages",   "key": "{#90}│{#37}  Packages {#90}│", "format": "{#90}│{#97} {all<34} {#90}│{#}" },
        { "type": "cpu",        "key": "{#90}│{#37}  CPU      {#90}│", "format": "{#90}│{#97} {name<34} {#90}│{#}" },
        { "type": "gpu",        "key": "{#90}│{#37}  GPU      {#90}│", "format": "{#90}│{#97} {name<34} {#90}│{#}" },
        { "type": "memory",     "key": "{#90}│{#37}  RAM      {#90}│", "format": "{#90}│{#97} {used>10} / {total<21} {#90}│{#}" },
        { "type": "custom", "format": "{#90}└────────────┘ └────────────────────────────────────┘" }
    ]
}
